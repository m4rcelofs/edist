<div class="tab-pane" id="config">

	<div class="text-center" data-bind="if: config.granularity() == null">
		<img id="config-loader" src="../img/loader.cache.gif" />
	</div>
	<div data-bind="if: config.granularity() != null">
		<form id="config-form" class="form-horizontal" role="form"
			data-bind="submit: saveConfig">
			<div class="form-group"></div>
			<div class="form-group">
				<label class="control-label col-md-6" for="muName">Nome da
					Unidade Militar</label>
				<div class="col-md-5">
					<input type="text" class="form-control" placeholder="nome da mu"
						required data-bind="value: config.muName">
				</div>
			</div>
			<div class="form-group">
				<label class="col-md-6 control-label" for="granularity">Granularidade
					da Configuração de Distribuição</label>
				<div class="col-md-5">
					<select class="form-control selectpicker show-menu-arrow show-tick"
						data-bind="value: config.granularity, updateSelectPicker:{}">
						<option value="MU">Unidade Militar</option>
						<option value="GROUP">Grupo</option>
						<option value="PLAYER">Jogador</option>
					</select>
				</div>
				<a href="#" class="help" data-toggle="popover" title
					data-content="Define qual o nível máximo de configuração das distribuições - você pode definir até uma configuração diferente para cada jogador! Caso essa configuração não exista, o nível superior será utilizado."
					data-original-title="Granularidade" data-bind="updatePopup:{}">
					<span class="glyphicon glyphicon-question-sign"></span>
				</a>
			</div>

			<div class="form-group">
				<label class="col-md-6 control-label" for="defaultConfigs">Configurações
					Padrão</label>
				<div class="col-md-5">
					<ul class="list-group">
						<li class="list-group-item"><a href="#" role="button"
							data-bind="click: editConfig">Configuração Padrão da
								Distribuição</a></li>
						<li class="list-group-item"><a href="#" role="button"
							data-bind="click: editFightVerif">Verificação Padrão de Lutas</a></li>
						<li class="list-group-item"><a href="#" role="button"
							data-bind="click: editWorkVerif">Verificação Padrão de
								Trabalho</a></li>
					</ul>
				</div>
				<a href="#" class="help" data-toggle="popover" title
					data-content="Utilizada caso você defina a granularidade como 'Unidade Militar' ou não configure os níveis abaixo"
					data-original-title="Distribuição padrão"
					data-bind="updatePopup:{}"> <span
					class="glyphicon glyphicon-question-sign"> </span>
				</a>
			</div>
			<div class="form-group">
				<label class="control-label col-md-6" for="avatarHistory">Manter
					histórico de avatares</label>
				<div class="col-md-5 text-center">
					<input type="checkbox" data-bind="checked: config.avatarHistory">
				</div>
				<a href="#" class="help" data-toggle="popover" title
					data-content="Armazena uma cópia de cada avatar utilizado pelo jogador"
					data-original-title="Histórico de Avatares"
					data-bind="updatePopup:{}"> <span
					class="glyphicon glyphicon-question-sign"></span>
				</a>
			</div>
			<div class="form-group">
				<label class="col-md-6 control-label" for="reportsAccess">Acesso
					aos Relatórios de Distribuição</label>
				<div class="col-md-5">
					<select class="form-control selectpicker show-menu-arrow show-tick"
						data-bind="value: config.reportsAccess, updateSelectPicker: config.reportsAccess">
						<option value="ADMINS">Administradores</option>
						<option value="MODS">Moderadores</option>
						<option value="VIEWER">Visitantes Registrados</option>
						<option value="PUBLIC">Público</option>
					</select>
				</div>
				<a href="#" class="help" data-toggle="popover" title
					data-content="Quem poderá acessar os relatórios de distribuição (FFs, itens enviados, etc)"
					data-original-title="Nível de Acesso" data-bind="updatePopup:{}">
					<span class="glyphicon glyphicon-question-sign"></span>
				</a>
			</div>
			<div class="form-group">
				<label class="control-label col-md-6" for="playerReportsAccess">Acesso
					aos Relatórios de Jogadores</label>
				<div class="col-md-5">
					<select class="form-control selectpicker show-menu-arrow show-tick"
						data-bind="value: config.playerReportsAccess, updateSelectPicker:{}">
						<option value="ADMINS">Administradores</option>
						<option value="MODS">Moderadores</option>
						<option value="VIEWER">Visitantes Registrados</option>
						<option value="PUBLIC">Público</option>
					</select>
				</div>
				<a href="#" class="help" data-toggle="popover" title
					data-content="Quem poderá acessar os relatórios de jogadores (lutas, força, etc)"
					data-original-title="Nível de Acesso" data-bind="updatePopup:{}">
					<span class="glyphicon glyphicon-question-sign"></span>
				</a>
			</div>
			<div class="form-group">
				<label class="control-label col-md-6" for="email">E-mail do
					Responsável</label>
				<div class="input-group col-md-5">
					<input type="email" class="form-control"
						placeholder="email@exemplo.com" required
						data-bind="value: config.contactEmail"> <span
						class="input-group-addon"> <span
						class="glyphicon glyphicon-envelope"></span>
					</span>
				</div>
			</div>
			<div class="form-group">
				<div class="col-md-offset-6 col-md-2">
					<button id="save-config" type="submit" class="btn btn-primary"
						data-loading-text="Salvando..." autocomplete="off">
						<span class="glyphicon glyphicon-floppy-disk"></span> Salvar
					</button>
				</div>
			</div>
		</form>
	</div>
</div>

<%@ include file="../distconfig/dist-config-root.jspf"%>