<div class="tab-pane" id="config">

	<div class="text-center">
		<img id="config-loader" src="../img/loader.cache.gif" />
	</div>
	<form id="config-form" class="form-horizontal" role="form"
		style="display: none;" onsubmit="return false;">
		<div class="form-group"></div>
		<div class="form-group">
			<label class="control-label col-lg-6" for="muName">Nome da
				Unidade Militar</label>
			<div class="col-lg-5">
				<input type="text" class="form-control" id="muName"
					placeholder="nome da mu" required>
			</div>
		</div>
		<div class="form-group">
			<label class="col-lg-6 control-label" for="granularity">Granularidade
				da Configuração de Distribuição</label>
			<div class="col-lg-5">
				<select class="form-control" data-style="btn-inverse"
					name="granularity" id="granularity">
					<option value="MU">Unidade Militar</option>
					<option value="GROUP">Grupo</option>
					<option value="PLAYER">Jogador</option>
				</select>
			</div>
			<a href="#" class="help" data-toggle="popover" title
				data-content="Define qual o nível máximo de configuração das distribuições - você pode definir até uma configuração diferente para cada jogador! Caso essa configuração não exista, o nível superior será utilizado."
				data-original-title="Granularidade"> <span
				class="glyphicon glyphicon-question-sign"></span>
			</a>
		</div>
		<div class="form-group 	text-center">
			<a href="#distConfigDialog" role="button" data-toggle="modal">Configuração
				Padrão da Distribuição</a> <a href="#" class="help"
				data-toggle="popover" title
				data-content="Utilizada caso você defina a granularidade como 'Unidade Militar' ou não configure os níveis abaixo"
				data-original-title="Distribuição padrão"> <span
				class="glyphicon glyphicon-question-sign">  </span>
			</a>
		</div>
		<div class="form-group">
			<label class="col-lg-6 control-label" for="reportsAccess">Acesso
				aos Relatórios de Distribuição</label>
			<div class="col-lg-5">
				<select class="form-control" data-style="btn-inverse"
					name="reportsAccess" id="reportsAccess">
					<option value="ADMINS">Administradores</option>
					<option value="MODS">Moderadores</option>
					<option value="VIEWER">Visitantes Registrados</option>
					<option value="PUBLIC">Público</option>
				</select>
			</div>
			<a href="#" class="help" data-toggle="popover" title
				data-content="Quem poderá acessar os relatórios de distribuição (FFs, itens enviados, etc)"
				data-original-title="Nível de Acesso"> <span
				class="glyphicon glyphicon-question-sign"></span>
			</a>
		</div>
		<div class="form-group">
			<label class="control-label col-lg-6" for="playerReportsAccess">Acesso
				aos Relatórios de Jogadores</label>
			<div class="col-lg-5">
				<select class="form-control" data-style="btn-inverse"
					name="playerReportsAccess" id="playerReportsAccess">
					<option value="ADMINS">Administradores</option>
					<option value="MODS">Moderadores</option>
					<option value="VIEWER">Visitantes Registrados</option>
					<option value="PUBLIC">Público</option>
				</select>
			</div>
			<a href="#" class="help" data-toggle="popover" title
				data-content="Quem poderá acessar os relatórios de jogadores (lutas, força, etc)"
				data-original-title="Nível de Acesso"> <span
				class="glyphicon glyphicon-question-sign"></span>
			</a>
		</div>
		<div class="form-group">
			<label class="control-label col-lg-6" for="email">E-mail do
				Responsável</label>
			<div class="input-group col-lg-5">
				<input type="email" class="form-control" id="contactEmail"
					placeholder="email@exemplo.com" required> <span
					class="input-group-addon"> <span
					class="glyphicon glyphicon-envelope"></span>
				</span>
			</div>
		</div>
		<div class="form-group">
			<div class="col-lg-offset-6 col-lg-2">
				<button id="save-config" type="submit" class="btn btn-primary"
					onclick="saveConfig()" data-loading-text="Salvando..."
					autocomplete="off">
					<span class="glyphicon glyphicon-floppy-disk"></span> Salvar
				</button>
			</div>
		</div>
	</form>
</div>

<%@ include file="../distconfig/distConfig.jspf"%>