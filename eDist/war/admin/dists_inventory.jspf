<div class="modal fade" id="distributorInventory" tabindex="-40"
	role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal"
					aria-hidden="true">×</button>
				<h3>
					<fmt:message key="admin.distributors.inventory" />
				</h3>
			</div>

			<div class="modal-body">
				<p>
					<fmt:message key="admin.distributors.lastAccess" />: <span
						data-bind="text: currentDistributor() && currentDistributor().lastAccessTimestamp ? 
								$.format.date(new Date(currentDistributor().lastAccessTimestamp), edist.format.date) : 
								'<fmt:message key="admin.distributors.noAccess"/>'"></span>
				</p>
				<table class="table table-striped table-hover table-responsive"
					data-bind="if: distributorInventory() && distributorInventory().WEAPONS">
					<thead>
						<tr>
							<th colspan="2"><fmt:message key="reports.requests.weapons" /></th>
						</tr>
						<tr>
							<th><fmt:message key="reports.requests.quality" /></th>
							<th><fmt:message key="reports.requests.quantity" /></th>
						</tr>
					</thead>
					<tbody data-bind="foreach: qualities">
						<tr
							data-bind="if: $root.inventoryContents('WEAPONS', $data) !== null">
							<td data-bind="text: $data"></td>
							<td data-bind="text: $root.inventoryContents('WEAPONS', $data)"></td>
						</tr>
					</tbody>
					<thead>
						<tr>
							<th colspan="2"><fmt:message key="reports.requests.food" /></th>
						</tr>
						<tr>
							<th><fmt:message key="reports.requests.quality" /></th>
							<th><fmt:message key="reports.requests.quantity" /></th>
						</tr>
					</thead>
					<tbody data-bind="foreach: qualities">
						<tr
							data-bind="if: $root.inventoryContents('FOOD', $data) !== null">
							<td data-bind="text: $data"></td>
							<td data-bind="text: $root.inventoryContents('FOOD', $data)"></td>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-dismiss="modal">
					<fmt:message key="shared.close" />
				</button>
			</div>
		</div>
	</div>
</div>