<div class="tab-pane" id="distributors">

	<div class="form-group"></div>

	<div class="panel-group" id="add-distributor-accordion">
		<div class="panel panel-default">
			<div class="panel-heading">
				<a class="accordion-toggle" data-toggle="collapse"
					data-parent="#add-distributor-accordion" href="#dist-collapse-one"><span
					class="glyphicon glyphicon-plus-sign"></span> <fmt:message
						key="admin.distributors.add" /> </a>
			</div>
			<div id="dist-collapse-one" class="panel-collapse collapse">
				<div class="panel-body">
					<div class="alert alert-info">
						<fmt:message key="admin.distributors.bronzeWarning" />
					</div>
					<form id="add-dist-form" class="form-inline" role="form"
						onsubmit="return false;">
						<div class="form-group">
							<label class="sr-only" for="new-dist-name"><fmt:message
									key="admin.distributors.name" /></label> <input type="text"
								class="form-control" id="new-dist-name"
								placeholder="<fmt:message key="admin.distributors.name"/>">
						</div>
						<div class="form-group">
							<label class="sr-only" for="new-dist-email"><fmt:message
									key="admin.distributors.email" /></label> <input type="email"
								class="form-control" id="new-dist-email"
								placeholder="<fmt:message key="admin.distributors.email"/>"
								required>
						</div>
						<div class="form-group">
							<label class="sr-only" for="new-dist-password"><fmt:message
									key="admin.distributors.password" /></label> <input type="password"
								class="form-control" id="new-dist-password"
								placeholder="<fmt:message key="admin.distributors.password"/>"
								required>
						</div>
						<a id="save-new-dist" data-toggle="modal"
							href="#addDistributorConfirmation" class="btn btn-primary"><span
							class="glyphicon glyphicon-floppy-disk"></span> <fmt:message
								key="shared.save" /></a>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div class="text-center" data-bind="if: distributors().length == 0">
		<img id="dists-loader" src="${baseUrl}/img/loader.cache.gif" />
	</div>

	<table class="table table-striped table-hover table-responsive"
		id="dists-table" data-bind="if: distributors().length > 0">
		<thead>
			<tr>
				<th><fmt:message key="admin.distributors.name" /></th>
				<th><fmt:message key="admin.distributors.email" /></th>
				<th><fmt:message key="admin.distributors.password" /></th>
				<th><fmt:message key="admin.distributors.lastAccess" /></th>
				<th><fmt:message key="admin.distributors.inventory" /></th>
				<th></th>
			</tr>
		</thead>
		<tbody data-bind="foreach: distributors">
			<tr data-bind="attr: {id: encodedKey}">
				<td><input type="text"
					placeholder="<fmt:message key="admin.distributors.name"/>"
					data-bind="value: name"></td>
				<td><input type="email"
					placeholder="<fmt:message key="admin.distributors.email"/>"
					data-bind="value: email"></td>
				<td><input type="password"
					placeholder="<fmt:message key="admin.distributors.password"/>"
					data-bind="value: password"></td>
				<td
					data-bind="text: lastAccessTimestamp ? $.format.date(new Date(lastAccessTimestamp), edist.format.date) : '<fmt:message key="admin.distributors.noAccess"/>'"></td>
				<td><a href="#distributorInventory" data-bind="click: $root.loadInventory">
						<fmt:message key="admin.distributors.showInventory" /> <span
						class="glyphicon glyphicon-new-window"></span>
					</a>
				</td>
				<td><a href="#saveDistributorConfirmation" role="button"
					data-toggle="modal"><span
						class="glyphicon glyphicon-floppy-disk"
						data-bind="click: $root.saveDistributor"></span></a></td>
			</tr>
		</tbody>
	</table>
	<div class="modal fade" id="addDistributorConfirmation" tabindex="-2"
		role="dialog" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal"
						aria-hidden="true">×</button>
					<h3><fmt:message key="admin.distributors.newConfirmation.title"/></h3>
				</div>
				<div class="modal-body">
					<fmt:message key="admin.distributors.newConfirmation.text"/>				
				</div>
				<div class="modal-footer">
					<button class="btn" data-dismiss="modal"
						data-bind="click: $root.addDistributor"><fmt:message key="admin.distributors.newConfirmation.agree"/></button>
					<button class="btn btn-danger" data-dismiss="modal"
						aria-hidden="true"><fmt:message key="admin.distributors.newConfirmation.doNotAgree"/></button>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="saveDistributorConfirmation" tabindex="-3"
		role="dialog" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal"
						aria-hidden="true">×</button>
					<h3><fmt:message key="admin.distributors.newConfirmation.title"/></h3>
				</div>
				<div class="modal-body">
					<fmt:message key="admin.distributors.newConfirmation.text"/>	
				</div>
				<div class="modal-footer">
					<button class="btn" data-dismiss="modal"><fmt:message key="admin.distributors.newConfirmation.ok"/></button>
				</div>
			</div>
		</div>
	</div>
	
	<%@ include file="dists_inventory.jspf"%> 
	
</div>