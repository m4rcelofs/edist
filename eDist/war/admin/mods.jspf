<div class="tab-pane active" id="users">
	<div class="form-group"></div>
	<div class="alert alert-info text-center">
		<p>
			<span class="glyphicon glyphicon-info-sign"></span> Adicione outros
			administradores no <a id="mods-control-panel-link"
				data-bind="attr : {href: controlPanelLocation()}" class="alert-link">Painel
				de Controle</a>
		</p>
	</div>
	<div class="text-center" data-bind="if: registeredUsers().length == 0">
		<img id="mods-loader" src="../img/loader.cache.gif" />
	</div>
	<table class="table table-striped table-hover table-responsive"
		data-bind="if: registeredUsers().length > 0" id="mods-table">
		<thead>
			<tr>
				<th>Nome</th>
				<th>E-mail</th>
				<th>Cargo</th>
				<th>Registro</th>
				<th></th>
			</tr>
		</thead>
		<tbody data-bind="foreach: registeredUsers">
			<tr data-bind="attr: {id: gId}">
				<td><input type="text" placeholder="nome/nick"
					data-bind="value: name"></td>
				<td data-bind="text: gEmail"></td>
				<td><select
					class="form-control selectpicker show-menu-arrow show-tick"
					name="role" data-bind="value: role, updateSelectPicker:{}">
						<option value="NONE">Nenhum</option>
						<option value="VIEWER">Visitante</option>
						<option value="MODERATOR">Moderador</option>
				</select></td>
				<td data-bind="text: $root.registeredDate($data)"></td>
				<td><a href="#" role="button"><span
						class="glyphicon glyphicon-floppy-disk"
						data-bind="click: $root.saveUser"></span></a> <a
					href="#removeUserConfirmation" role="button" data-toggle="modal"><span
						class="glyphicon glyphicon-remove"
						data-bind="click: $root.selectedUser"></span></a></td>
			</tr>
		</tbody>
	</table>
	<ul class="pager">
		<li class="next"
			data-bind="css: {disabled: cursor() === null},
						click: loadNextPage"><a
			href="#">Exibir próximos</a></li>
	</ul>

	<div class="modal fade" id="removeUserConfirmation" tabindex="-1"
		role="dialog" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal"
						aria-hidden="true">×</button>
					<h3 id="myModalLabel">Confirmar Remoção</h3>
				</div>
				<div class="modal-body">
					<p class="error-text">
						Tem certeza que deseja remover as permissões para <span
							data-bind="text: selectedUserEmail"></span>?
					</p>
				</div>
				<div class="modal-footer">
					<button class="btn btn-danger" data-dismiss="modal"
						data-bind="click: confirmUserRemoval">Excluir</button>
					<button class="btn" data-dismiss="modal" aria-hidden="true">Cancelar</button>
				</div>
			</div>
		</div>
	</div>
</div>