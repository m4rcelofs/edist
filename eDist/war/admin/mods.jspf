<div class="tab-pane active" id="moderators">
	<div class="form-group"></div>
	<div class="alert alert-info text-center">
		<p>
			<span class="glyphicon glyphicon-info-sign"></span> Adicione outros
			administradores no <a id="mods-control-panel-link" href=""
				class="alert-link">Painel de Controle</a>
		</p>
	</div>
	<div class="text-center">
		<img id="mods-loader" src="../img/loader.cache.gif" />
	</div>
	<table class="table table-striped table-hover" style="display: none;"
		id="mods-table">
		<thead>
			<tr>
				<th>Nome</th>
				<th>E-mail</th>
				<th>Cargo</th>
				<th>Registro</th>
				<th></th>
			</tr>
		</thead>
		<tbody></tbody>
	</table>
	<ul class="pager">
		<li id="previousMods" class="previous disabled"><a
			href="#moderators" onclick="previousPage();">&larr; Anteriores</a></li>
		<li><span id="mods-current-page" class="pagination-center"></span></li>
		<li id="nextMods" class="next"><a href="#moderators"
			onclick="nextPage();">Próximos &rarr;</a></li>
	</ul>
</div>

<div class="modal fade" id="removeUserConfirmation" tabindex="-1"
	role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal"
					aria-hidden="true">×</button>
				<h3 id="myModalLabel">Confirmar Remoção</h3>
			</div>
			<div class="modal-body">
				<p class="error-text">Tem certeza que deseja remover as
					permissões desse usuário?</p>
			</div>
			<div class="modal-footer">
				<button class="btn btn-danger" data-dismiss="modal"
					onclick="confirmUserRemoval();">Excluir</button>
				<button class="btn" data-dismiss="modal" aria-hidden="true">Cancelar</button>
			</div>
		</div>
	</div>
</div>