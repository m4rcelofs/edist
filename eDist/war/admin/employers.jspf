<div class="tab-pane" id="employers">

	<div class="form-group"></div>
	<div class="alert alert-info text-center">
		<a data-toggle="modal" href="#employerScriptInstructionsModal"> <span
			class="glyphicon glyphicon-info-sign"></span> <fmt:message
				key="admin.employers.instructions.title" />
		</a>
	</div>
	<div class="panel-group" id="add-employer-accordion">
		<div class="panel panel-default">
			<div class="panel-heading">
				<a class="accordion-toggle" data-toggle="collapse"
					data-parent="#add-employer-accordion" href="#employer-collapse-one"><span
					class="glyphicon glyphicon-plus-sign"></span> <fmt:message
						key="admin.employers.add" /></a>
			</div>
			<div id="employer-collapse-one" class="panel-collapse collapse">
				<div class="panel-body">
					<form id="add-employer-form" class="form-inline" role="form"
						onsubmit="return false;">
						<div class="form-group">
							<label class="sr-only" for="new-employer-name"><fmt:message
									key="admin.employers.name" /></label> <input type="text"
								class="form-control" id="new-employer-name"
								placeholder="<fmt:message key="admin.employers.name"/>">
						</div>
						<div class="form-group">
							<label class="sr-only" for="new-employer-id"><fmt:message
									key="admin.employers.id" /></label> <input type="number"
								class="form-control" id="new-employer-id"
								placeholder="<fmt:message key="admin.employers.id"/>" required>
						</div>
						<button class="btn btn-primary"
							data-bind="click: $root.addEmployer">
							<span class="glyphicon glyphicon-floppy-disk"></span>
							<fmt:message key="shared.save" />
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<div class="text-center" data-bind="if: employers().length == 0">
		<img id="employers-loader" src="${baseUrl}/img/loader.cache.gif" />
	</div>

	<table class="table table-striped table-hover table-responsive"
		data-bind="if: employers().length > 0" id="employers-table">
		<thead>
			<tr>
				<th><fmt:message key="admin.employers.name" /></th>
				<th><fmt:message key="admin.employers.lastUpdate" /></th>
				<th><fmt:message key="admin.employers.registeredWorkers" /></th>
				<th></th>
			</tr>
		</thead>
		<tbody data-bind="foreach: employers">
			<tr data-bind="attr: {id: encodedKey}">
				<td><a
					data-bind="attr: {href: 'http://www.erepublik.com/en/citizen/profile/' + erId}, text: name"></a></td>
				<td
					data-bind="text: lastUpdatedAt ? $.format.date(lastUpdatedAt, edist.format.date) : '<fmt:message key="admin.employers.noUpdate"/>'"></td>
				<td><a data-bind="text: playersCount ? playersCount : '', attr:{href: '${baseUrl}/reports/work/employer/' + encodedKey }"></a></td>
				<td><a data-toggle="modal" href="#employerKeyModal"
					data-bind="click: $root.selectedEmployer"> <span
						class="glyphicon glyphicon-barcode"></span> <fmt:message
							key="admin.employers.authKey" />
				</a></td>
			</tr>
		</tbody>
	</table>


	<div class="modal fade" id="employerKeyModal" tabindex="-3"
		role="dialog" aria-hidden="true">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<button type="button" class="close" data-dismiss="modal"
						aria-hidden="true">×</button>
					<h3>
						<fmt:message key="admin.employers.authKey" />
					</h3>
				</div>
				<div class="modal-body">
					<fmt:message key="admin.employers.authKey.text" />
					<form class="form-horizontal" role="form" onsubmit="return false;">
						<div class="form-group">
							<label for="employer-modal-name" class="col-lg-2 control-label"><fmt:message
									key="admin.employers.name" />:</label>
							<div class="col-lg-10">
								<input type="text" class="form-control" id="employer-modal-name"
									readonly="readonly"
									data-bind="value: $root.selectedEmployerName">
							</div>
						</div>
						<div class="form-group">
							<label for="employer-modal-key" class="col-lg-2 control-label"><fmt:message
									key="admin.employers.authKey" />:</label>
							<div class="col-lg-10">
								<textarea class="form-control" id="employer-modal-key" readonly
									data-bind="value: $root.selectedEmployerKey"></textarea>
							</div>
						</div>
					</form>
				</div>
				<div class="modal-footer">
					<button class="btn btn-primary" data-dismiss="modal">
						<fmt:message key="shared.close" />
					</button>
				</div>
			</div>
		</div>
	</div>
</div>


<div class="modal fade" id="employerScriptInstructionsModal"
	tabindex="-4" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal"
					aria-hidden="true">×</button>
				<h3>
					<fmt:message key="admin.employers.instructions.title" />
				</h3>
			</div>
			<div class="modal-body">
				<p>
					<fmt:message key="admin.employers.instructions.text" />
				</p>
				<fmt:message key="admin.employers.instructions.textManager" />
				<a href="${baseUrl}/js/dynamic/employer.user.js"><fmt:message
						key="admin.employers.instructions.textManager2" /></a>
				<fmt:message key="admin.employers.instructions.textManager3" />

				<fmt:message key="admin.employers.instructions.textAdmin" />
				<a href="${baseUrl}/management/playersList/search"><fmt:message
						key="admin.employers.instructions.textAdmin2" /></a>
				<fmt:message key="admin.employers.instructions.textAdmin3" />
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-dismiss="modal">
					<fmt:message key="shared.close" />
				</button>
			</div>
		</div>
	</div>
</div>