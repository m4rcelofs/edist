<table class="table table-striped table-hover table-responsive"
	data-bind="if: !isLoading() && dailies().length > 0">
	<thead>
		<tr>
			<th><fmt:message key="filters.dayPlaceholder" /></th>
			<th colspan="6"><fmt:message key="header.players" /></th>
			<th>Influência</th>
		</tr>
		<tr>
			<th></th>
			<th>Habilitados</th>
			<th>Ativos</th>
			<th>Lutadores</th>
			<th>Mortos</th>
			<th>Banidos Perman.</th>
			<th>Banidos Temp.</th>
			<th></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: dailies">
		<tr data-bind="attr: {id: encodedKey}">
			<td><a
				data-bind="text: day, attr:{href: '${baseUrl}/players/history/day/' + day}"></a>
			</td>
			<td data-bind="text: enabledCount"></td>
			<td data-bind="text: $root.countFromDivision('activeCount', $data)"></td>
			<td data-bind="text: $root.countFromDivision('fightersCount', $data)"></td>
			<td data-bind="text: deadCount ? deadCount : '0'"></td>
			<td data-bind="text: permaBannedCount ? permaBannedCount : '0'"></td>
			<td data-bind="text: tempBannedCount ? tempBannedCount : '0'"></td>
			<td data-bind="text: $.format.number($root.countFromDivision('influence', $data), edist.format.number)"></td>
		</tr>
	</tbody>
	<tfoot>
		<tr data-bind="attr: {id: monthly() ? monthly().encodedKey : ''}">
			<td><fmt:message key="reports.stats.total.title" /></td>
			<td></td>
			<td></td>
			<td></td>
			<td data-bind="text: monthly().deadCount ? monthly().deadCount : '0'"></td>
			<td data-bind="text: monthly().permaBannedCount ? monthly().permaBannedCount : '0'"></td>
			<td data-bind="text: monthly().tempBannedCount? monthly().tempBannedCount: '0'"></td>
			<td data-bind="text: $.format.number($root.countFromDivision('influence', monthly()), edist.format.number)"></td>
		</tr>
	</tfoot>
</table>