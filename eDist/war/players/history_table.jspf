<table class="table table-striped table-hover table-responsive"
	data-bind="if: statsHistory().length > 0">
	<thead>
		<tr>
			<th data-bind="visible: category() === 'player'"><fmt:message
					key="players.fights.day" /></th>
			<th colspan="2"><fmt:message key="players.fights.player" /></th>
			<th data-bind="visible: category() !== 'group' && edist.user.hasManagementAccess"><fmt:message
					key="players.fights.groups" /></th>
			<th colspan="2"><fmt:message key="players.history.xp" /></th>
			<th><fmt:message key="players.history.str" /></th>
			<th><fmt:message key="players.history.rank" /></th>
			<th><fmt:message key="players.history.maxHit" /></th>
			<th data-bind="visible: $root.category() === 'player'"><fmt:message
					key="players.fights.damage" /> <a href="#" class="help"
				data-toggle="popover" title
				data-content="<fmt:message key="players.fights.calculatedFights.help"/>"
				data-bind="updatePopup:{}"> <span
					class="glyphicon glyphicon-question-sign"></span>
			</a></th>
			<th
				data-bind="visible: edist.user.hasReportsAccess || edist.user.hasManagementAccess"></th>
			<th></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: statsHistory">
		<tr data-bind="css:{danger: isDead || isPermaBan, warning: isTempBan}">
			<td data-bind="visible: $root.category() === 'player'"><a
				data-bind="text: day, attr: {href : '#/players/history/day/'+day}"></a>
			</td>
			<td class="text-center">
				<img class="img-thumbnail img-responsive player-avatar-small"
					src="${baseUrl}/img/profile_avatar_55.cache.png"
					data-bind="style: {backgroundImage : Players.avatar($data) !== null ? Players.avatar($data) :
								'url(${baseUrl}/img/default_male_55.cache.gif)'},
							avatarEnhance:{},
							attr:{'data-toggle': 'popover', 
								'data-content': (isDead ? 'Dead Citizen' : '') + (isDead && banTip ? ' | ' : '') + (banTip ? banTip : '')},
							updatePopup:{}">
				<img height="15px" data-bind="attr:{src: '${baseUrl}/img/flags-round/' + (citizenship ? citizenship.toLowerCase() : 'zz') + '.png'}">
			</td>
			<td><a
				data-bind="attr: {href : '#/players/history/player/' + (erId ? erId : '')}, text: name">
			</a></td>
			<td data-bind="visible: $root.category() !== 'group' && edist.user.hasManagementAccess">
				<p data-bind="foreach: groups">
					<a
						data-bind="text: groupName ? groupName : '<fmt:message key="distconfig.distributor.noName"/>', attr: {href : '#/players/history/group/'+$parent.day+'/'+encodedKey}"></a>
					<br />
				</p>
			</td>
			<td><span
				data-bind="text: $.format.number(xp, edist.format.number)"></span> <span
				data-bind="if: $root.statsHistory().length > $index() + 1 && $root.category() === 'player'">
					<span class="badge pull-right"
					data-bind="text: '+' +  $.format.number(xp - $root.statsHistory()[$index() + 1].xp, edist.format.number)"></span>
			</span></td>
			<td data-bind="if: $root.category() !== 'division'">
				<a data-bind="text: div, attr: {href: '${baseUrl}/players/history/division/' + day + '/' + (div ? div : '')}"></a>
			</td>
			<td><span
				data-bind="text:  $.format.number(strength, edist.format.number)"></span>
				<span
				data-bind="if: $root.statsHistory().length > $index() + 1 && $root.category() === 'player'">
					<span class="badge pull-right"
					data-bind="text: '+' + $.format.number(strength - $root.statsHistory()[$index() + 1].strength, edist.format.number)"></span>
			</span></td>
			<td><img width="30px"
				data-bind="attr: {'data-content':  $.format.number(rank, edist.format.number) + ' <fmt:message key="players.history.points"/>', 
										src: '${baseUrl}/img/ranks/' + RankCalculator.getRank(rank).rank + '.png'},
								updatePopup:{}"
				data-toggle="popover"> <span
				data-bind="text: RankCalculator.getRank(rank).name"></span> <span
				data-bind="if: $root.statsHistory().length > $index() + 1 && $root.category() === 'player'">
			</span></td>
			<td><span
				data-bind="text: $.format.number(maxHit, edist.format.number)"></span>
				<span
				data-bind="if: $root.statsHistory().length > $index() + 1 && $root.category() === 'player'">
					<span class="badge"
					data-bind="text: '+' +  $.format.number(maxHit - $root.statsHistory()[$index() + 1].maxHit, edist.format.number)"></span>
			</span></td>
			<td data-bind="visible: $root.category() === 'player'">
				<span data-bind="if: $root.statsHistory().length > $index() + 1 && $root.category() === 'player'">
					<span
					data-bind="text: Players.calculateDamage(rank, $root.statsHistory()[$index() + 1].rank)"></span>
				</span>
			</td>
			<td>
				<span class="glyphicon glyphicon-time"
				data-bind="attr: {'data-content': '<fmt:message key="players.history.collectedDate" />: ' + $.format.date(collectedAt, edist.format.date)}, updatePopup:{}"
				data-toggle="popover"></span></td>
			<td
				data-bind="visible: edist.user.hasManagementAccess || edist.user.hasReportsAccess">
				
				<div class="btn-toolbar">
                    <div class="btn-group">
                        <button class="btn btn-default dropdown-toggle" 
                        		data-toggle="dropdown"
                        		title="<fmt:message key="management.players.actions"/>">
                        	<span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                            	<a data-bind="if: edist.user.hasManagementAccess,
											  attr: {href: '${baseUrl}/management/playersList/search/' + (erId ? erId : '')  }">
									<span class="glyphicon glyphicon-list"></span> <fmt:message key="header.mod"/>
								</a>
							</li>
                            <li>
                            	<a data-bind="if: edist.user.hasReportsAccess, 
										attr: {href: '${baseUrl}/reports/requests/player/' + (erId ? erId : '')  }">
									<span class="glyphicon glyphicon-cutlery"></span> <fmt:message key="management.players.template.dist"/>
								</a>
                            </li>
                            <li>
                            	<a data-bind="if: edist.user.hasReportsAccess, 
									attr: {href: '${baseUrl}/reports/work/player/' + (erId ? erId : '') }">
									<span class="glyphicon glyphicon-wrench"></span> <fmt:message key="management.players.template.work"/>
								</a>
                            </li>
                            <li>
                            	 <a data-bind="if: edist.user.hasReportsAccess, 
											attr: {href: '${baseUrl}/reports/fights/player/' + (erId ? erId : '')  }">
									<span class="glyphicon glyphicon-screenshot"></span> <fmt:message key="management.players.template.fights"/>
								</a>
                            </li>
                        </ul>
                    </div>
                </div> 
			</td>
		</tr>
	</tbody>
</table>