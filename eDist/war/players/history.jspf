<div class="tab-pane active" id="history">
	<div class="row">
		<div class="form-group"></div>

		<div class="col-md-2">

			<ul id="history.horizontal.nav" class="nav nav-pills nav-stacked">
				<!-- 				<li data-bind="css: {active : category() === 'date'}"><a -->
				<!-- 					href="#/players/history/date"><fmt:message key="filters.byDate" /></a></li> -->
				<li data-bind="css: {active : category() === 'day'}"><a
					href="#/players/history/day"><fmt:message
							key="filters.allPlayers" /></a></li>
				<li data-bind="css: {active : category() === 'group'}"><a
					href="#/players/history/group"><fmt:message
							key="filters.byGroup" /></a></li>
				<li data-bind="css: {active : category() === 'division'}"><a
					href="#/players/history/division"><fmt:message
							key="filters.byDivision" /></a></li>
				<li data-bind="css: {active : category() === 'player'}"><a
					href="#/players/history/player"><fmt:message
							key="filters.search" /></a></li>
			</ul>
		</div>
		<div class="col-md-10">

			<%@ include file="history_filters.jspf"%>

			<%@ include file="history_table.jspf"%>

			<ul class="pager">
				<li class="next"
					data-bind="css: {disabled: cursor() === null || cursor() === ''},
						click: loadNextPage"><a
					href="#"><fmt:message key="shared.showNext" /></a></li>
			</ul>
		</div>
	</div>
	<div class="form-group"></div>
</div>