<div data-bind="">
	<nav class="navbar navbar-default" role="navigation">
		<div class="navbar-header">
			<button type="button" class="navbar-toggle" data-toggle="collapse"
				data-target="#statistics-filter-collapse">
				<span class="sr-only">	<fmt:message key="filters.openClose"/></span> <span
					class="icon-bar"></span> <span class="icon-bar"></span> <span
					class="icon-bar"></span>
			</button>
			<p class="navbar-text">	<fmt:message key="filters.title"/></p>
		</div>
		<div class="collapse navbar-collapse" id="statistics-filter-collapse">
			<form class="navbar-form navbar-right" role="search"
				data-bind="submit: doSearch">
				<div class="form-group" data-bind="">
					<select class="selectpicker show-menu-arrow navbar-btn show-tick"
						data-bind="options: filters.availableRequests, 
									value: filters.searchText, 
									enable: filters.availableRequests().length > 0,
									updateSelectPicker: filters.availableRequests">
					</select>
				</div>
				<button type="submit" class="btn btn-default">
					<span class="glyphicon glyphicon-search"></span> <span
						class="sr-only"><fmt:message key="filters.filter"/></span>
				</button>
			</form>
		</div>
	</nav>
</div>