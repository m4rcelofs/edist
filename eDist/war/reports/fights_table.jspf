<table class="table table-striped table-hover table-responsive"
	data-bind="if: fightsHistory().length > 0">
	<thead>
		<tr>
			<th data-bind="if: category() !== 'day'"><fmt:message
					key="players.fights.day" /></th>
			<th colspan="2"><fmt:message key="players.fights.player" /></th>
			<th data-bind="if: category() !== 'group'"><fmt:message
					key="players.fights.groups" /></th>
			<th><fmt:message key="players.fights.calculatedFights" /> <abbr
				title="Food Fights" class="initialism">(FF)</abbr> <a href="#"
				class="help" data-toggle="popover" title
				data-content="<fmt:message key="players.fights.calculatedFights.help"/>"
				data-bind="updatePopup:{}"> <span
					class="glyphicon glyphicon-question-sign"></span>
			</a></th>
			<th><fmt:message key="players.fights.damage" /></th>
			<th><fmt:message key="players.fights.weapons" /></th>
			<th></th>
			<th colspan="2"><fmt:message key="players.fights.dist" /></th>
			<th></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: fightsHistory">
		<tr>
			<td data-bind="if: $root.category() !== 'day'"><a
				data-bind="text: day, attr: {href : '#/reports/fights/day/'+day}"></a>
			</td>
			<td class="text-center"><img
				class="img-thumbnail img-responsive player-avatar-small"
				src="${baseUrl}/img/profile_avatar_55.cache.png"
				data-bind="style: { backgroundImage : Reports.avatar($data) !== null ? Reports.avatar($data) :
									'url(${baseUrl}/img/default_male_55.cache.gif)'},
							avatarEnhance:{}">
			</td>
			<td><a
				data-bind="attr: {href : '#/reports/fights/player/' + (stats ? stats.erId : '')}, text: stats ? stats.name : ''">
			</a></td>
			<td data-bind="if: $root.category() !== 'group'">
				<p data-bind="foreach: groups">
					<a
						data-bind="text: groupName ? groupName : '<fmt:message key="distconfig.distributor.noName"/>', attr: {href : '#/reports/fights/group/'+encodedKey}"></a>
					<br />
				</p>
			</td>
			<td><span
				data-bind="text: $.format.number(calculatedFfFights, edist.format.number)"></span>
				<span
				data-bind="if: $root.fightsHistory().length > $index() + 1 && $root.category() === 'player'">
					<span class="badge"
					data-bind="text: $root.fightDifference($data, $root.fightsHistory()[$index() + 1])"></span>
			</span></td>
			<td
				data-bind="text: calculatedRankDamage ? $.format.number(calculatedRankDamage, edist.format.number) : ''"></td>
			<td><span data-bind="text: $root.weaponsUsed($data)"></span> <img
				class="weapon"
				data-bind="attr: {title: calculatedWithWeaponQuality, 
									   src: '${baseUrl}/img/weapons/' + calculatedWithWeaponQuality + '.png'}">
			</td>
			<td><span data-bind="if: guerrillaWon"> <img
					src="${baseUrl}/img/weapons/guerrilla_won.png"> <span
					data-bind="text: guerrillaWon"></span>
			</span> <span data-bind="if: guerrillaLost"> <img
					src="${baseUrl}/img/weapons/guerrilla_lost.png"> <span
					data-bind="text: guerrillaLost"></span>
			</span> <span data-bind="if: smallBombsUsed"> <img
					src="${baseUrl}/img/weapons/small_bomb.png" width="30px"> <span
					data-bind="text: smallBombsUsed"></span>
			</span> <span data-bind="if: bigBombsUsed"> <img
					src="${baseUrl}/img/weapons/big_bomb.png" width="30px"> <span
					data-bind="text: bigBombsUsed"></span>
			</span></td>
			<td><a
				data-bind="attr: { href: edist.user.hasReportsAccess === true ? 
								'${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '') 
								: '' }">
					<span data-bind="if: verificationStatus === null"
					class="label label-default"><fmt:message
							key="shared.unknown" /></span> <span
					data-bind="if: verificationStatus === 'TEMP_BANNED'"
					class="label label-danger"> <span
						class="glyphicon glyphicon-ban-circle"></span> <fmt:message
							key="shared.tempBanned" />
				</span> <span data-bind="if: verificationStatus === 'WARNING'"
					class="label label-warning"> <span
						class="glyphicon glyphicon-exclamation-sign"></span> <fmt:message
							key="shared.warning" />
				</span> <span data-bind="if: verificationStatus === 'OK'"
					class="label label-success"> <span
						class="glyphicon glyphicon-ok"></span> <fmt:message
							key="shared.ok" />
				</span>
			</a></td>
			<td data-bind="if: verifiedAt"><span
				class="glyphicon glyphicon-time"
				data-bind="attr: {'data-content': '<fmt:message key="reports.verifiedAt" />: ' + (verifiedAt ? $.format.date(verifiedAt, edist.format.date) : '')}, updatePopup:{}"
				data-toggle="popover"></span></td>
			<td>
				<div class="btn-toolbar">
					<div class="btn-group">
						<button class="btn btn-default dropdown-toggle"
							data-toggle="dropdown"
							title="<fmt:message key="management.players.actions"/>">
							<span class="caret"></span>
						</button>
						<ul class="dropdown-menu">
							<li><a
								data-bind="if: edist.user.hasManagementAccess,
											  attr: {href: '${baseUrl}/management/playersList/search/' + (stats ? stats.erId : '')  }">
									<span class="glyphicon glyphicon-list"></span> <fmt:message
										key="header.mod" />
							</a></li>
							<li><a
								data-bind="attr: {href: '${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '')  }">
									<span class="glyphicon glyphicon-cutlery"></span> <fmt:message
										key="management.players.template.dist" />
							</a></li>
							<li><a
								data-bind="attr: {href: '${baseUrl}/reports/work/player/' + (stats ? stats.erId : '') }">
									<span class="glyphicon glyphicon-wrench"></span> <fmt:message
										key="management.players.template.work" />
							</a></li>
							<li><a
								data-bind="attr: {href: '${baseUrl}/players/history/player/' + (stats ? stats.erId : '') }">
									<span class="glyphicon glyphicon-calendar"></span> <fmt:message
										key="players.history" />
							</a></li>
						</ul>
					</div>
				</div>
			</td>
		</tr>
	</tbody>
</table>