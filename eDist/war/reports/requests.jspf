<div class="tab-pane" id="requests">
	<div class="row">
		<div class="form-group"></div>

		<div class="col-md-2">

			<ul id="requests.horizontal.nav" class="nav nav-pills nav-stacked">
				<li data-bind="css: {active : category() === 'date'}"><a
					href="#/reports/requests/date"><fmt:message
							key="filters.byDate" /></a></li>
				<li data-bind="css: {active : category() === 'day'}"><a
					href="#/reports/requests/day"><fmt:message key="filters.byDay" /></a></li>
				<li data-bind="css: {active : category() === 'distributor'}"><a
					href="#/reports/requests/distributor"><fmt:message
							key="filters.byDistributor" /></a></li>
				<li data-bind="css: {active : category() === 'group'}"><a
					href="#/reports/requests/group"><fmt:message
							key="filters.byGroup" /></a></li>
				<li data-bind="css: {active : category() === 'player'}"><a
					href="#/reports/requests/player"><fmt:message
							key="filters.byPlayer" /></a></li>
				<li data-bind="css: {active : category() === 'status'}"><a
					href="#/reports/requests/status"><fmt:message
							key="filters.byStatus" /></a></li>
				<li data-bind="css: {active : category() === 'type'}"><a
					href="#/reports/requests/type"><fmt:message
							key="filters.byType" /></a></li>
			</ul>
		</div>
		<div class="col-md-10">

			<%@ include file="requests_filters.jspf"%>

			<%@ include file="requests_table.jspf"%>

			<ul class="pager">
				<li class="next"
					data-bind="css: {disabled: cursor() === null},
						click: loadNextPage"><a
					href="#"><fmt:message key="shared.showNext" /></a></li>
			</ul>
		</div>
	</div>
	<div class="form-group"></div>

	<%@ include file="requests_details.jspf"%>

</div>