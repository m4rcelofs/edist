<div class="tab-pane active" id="fights">
	<div class="row">
		<div class="form-group"></div>

		<div class="col-md-2">

			<ul id="fights.horizontal.nav" class="nav nav-pills nav-stacked">
				<li data-bind="css: {active : category() === 'date'}"><a
					href="#/reports/fights/date"><fmt:message key="filters.byDate"/></a></li>
				<li data-bind="css: {active : category() === 'day'}"><a
					href="#/reports/fights/day"><fmt:message key="filters.byDay"/></a></li>
				<li data-bind="css: {active : category() === 'group'}"><a
					href="#/reports/fights/group"><fmt:message key="filters.byGroup"/></a></li>
				<li data-bind="css: {active : category() === 'player'}"><a
					href="#/reports/fights/player"><fmt:message key="filters.byPlayer"/></a></li>
			</ul>
		</div>
		<div class="col-md-10">

			<%@ include file="fights_filters.jspf"%>

			<%@ include file="fights_table.jspf"%>

			<ul class="pager">
				<li class="next"
					data-bind="css: {disabled: cursor() === null || cursor() === ''},
						click: loadNextPage"><a
					href="#"><fmt:message key="shared.showNext"/></a></li>
			</ul>
		</div>
	</div>
	<div class="form-group"></div>
</div>