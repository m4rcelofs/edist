<table class="table table-striped table-hover table-responsive"
	data-bind="if: works().length > 0">
	<thead>
		<tr>
			<th data-bind="if: category() !== 'day'"><fmt:message
					key="players.fights.day" /></th>
			<th><fmt:message key="players.fights.player" /></th>
			<th data-bind="if: category() !== 'group'"><fmt:message
					key="players.fights.groups" /></th>
			<th data-bind="if: category() !== 'employer'"><fmt:message
					key="reports.work.employer" /></th>
			<th><fmt:message key="reports.work.worked" /></th>
			<th><fmt:message key="management.groups.dist" /></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: works">
		<tr>
			<td data-bind="if: $root.category() !== 'day'"><a
				data-bind="text: day, attr: {href : '#/reports/work/day/'+day}"></a>
			</td>
			<td>
				<p class="text-center">
					<a
						data-bind="attr: {href : '#/reports/work/player/' + (stats ? stats.erId : '')}">
						<img class="img-thumbnail img-responsive"
						src="${baseUrl}/img/profile_avatar_55.cache.png" width="55px"
						data-bind="style: { backgroundImage : Reports.avatar($data) !== null ? Reports.avatar($data) :
										 'url(${baseUrl}/img/default_male_55.cache.gif)' ,
										 backgroundSize : '55px 55px',
										 backgroundRepeat : 'no-repeat',
										 backgroundPosition : 'center'},
									attr : {'data-content' : stats ? stats.name : ''},
									updatePopup:{}"
						data-toggle="popover">
					</a>
				</p>
				<p class="text-center">
					<a data-toggle="popover"
						data-content="<fmt:message key="header.mod"/>"
						data-bind="if: edist.user.hasManagementAccess,
								   attr: {href: '${baseUrl}/management/playersList/search/' + (erId ? erId : '')  }, updatePopup:{}"><span
						class="glyphicon glyphicon-list"></span></a> <a data-toggle="popover"
						data-content="<fmt:message key="management.players.template.dist"/>"
						data-bind="attr: {href: '${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '') }, updatePopup:{}"><span
						class="glyphicon glyphicon-cutlery"></span></a> <a
						data-toggle="popover"
						data-content="<fmt:message key="management.players.template.stats"/>"
						data-bind="if: edist.user.hasPlayerReportsAccess,
								   attr: {href: '${baseUrl}/players/history/player/' + (stats ? stats.erId : '') }, updatePopup:{}"><span
						class="glyphicon glyphicon-stats"></span></a> <a data-toggle="popover"
						data-content="<fmt:message key="management.players.template.fights"/>"
						data-bind="if: edist.user.hasPlayerReportsAccess,
								   attr: {href: '${baseUrl}/reports/fights/player/' + (stats ? stats.erId : '') }, updatePopup:{}"><span
						class="glyphicon glyphicon-screenshot"></span></a>
				</p>
			</td>
			<td data-bind="if: $root.category() !== 'group'">
				<p data-bind="foreach: groups">
					<a
						data-bind="text: groupName ? groupName : '<fmt:message key="distconfig.distributor.noName"/>', attr: {href : '#/reports/work/group/'+encodedKey}"></a>
					<br />
				</p>
			</td>
			<td data-bind="if: $root.category() !== 'employer'"><a
				data-bind="text: employer ? employer.name ? employer.name : '<fmt:message key="distconfig.distributor.noName"/>' : '',
							attr: {href : employer ? '#/reports/work/employer/'+employer.encodedKey : ''}"></a></td>
			<td>
				<p>
					<span data-bind="if: worked === null" class="label label-default"><fmt:message
							key="shared.unknown" /></span> <span data-bind="if: worked === false"
						class="label label-danger"> <span
						class="glyphicon glyphicon-ban-circle"></span> <fmt:message
							key="shared.no" />
					</span> <span data-bind="if: worked === true" class="label label-success">
						<span class="glyphicon glyphicon-ok"></span> <fmt:message
							key="shared.yes" />
					</span>
				</p>
			</td>
			<td><a
				data-bind="attr: { href: '${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '') }">
					<span data-bind="if: verificationStatus === null"
					class="label label-default"><fmt:message
							key="shared.unknown" /></span> <span
					data-bind="if: verificationStatus === 'TEMP_BANNED'"
					class="label label-danger"> <span
						class="glyphicon glyphicon-ban-circle"></span> <fmt:message
							key="shared.tempBanned" />
				</span> <span data-bind="if: verificationStatus === 'WARNING'"
					class="label label-warning"> <span
						class="glyphicon glyphicon-exclamation-sign"></span> <fmt:message
							key="shared.warning" />
				</span> <span data-bind="if: verificationStatus === 'OK'"
					class="label label-success"> <span
						class="glyphicon glyphicon-ok"></span> <fmt:message
							key="shared.ok" />
				</span>
			</a></td>
		</tr>
	</tbody>
</table>