<table class="table table-striped table-hover table-responsive"
	data-bind="if: works().length > 0">
	<thead>
		<tr>
			<th><fmt:message key="players.fights.day" /></th>
			<th colspan="2"><fmt:message key="players.fights.player" /></th>
			<th><fmt:message key="players.fights.groups" /></th>
			<th><fmt:message key="reports.work.employer" /></th>
			<th><fmt:message key="reports.work.worked" /></th>
			<th><fmt:message key="management.groups.dist" /></th>
			<th></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: works">
		<tr>
			<td data-bind="text: day"></td>
			<td class="text-center"><img
				class="img-thumbnail img-responsive player-avatar-small"
				src="${baseUrl}/img/profile_avatar_55.cache.png"
				data-bind="style: { backgroundImage : Reports.avatar($data) !== null ? Reports.avatar($data) :
									'url(${baseUrl}/img/default_male_55.cache.gif)'},
							avatarEnhance:{}">
			</td>
			<td data-bind="text: stats ? stats.name : ''"></td>
			<td>
				<p data-bind="foreach: groups">
					<a
						data-bind="text: groupName ? groupName : '<fmt:message key="distconfig.distributor.noName"/>', attr: {href : '#/reports/work/group/'+encodedKey}"></a>
					<br />
				</p>
			</td>
			<td><a
				data-bind="text: employer ? employer.name ? employer.name : '<fmt:message key="distconfig.distributor.noName"/>' : '',
							attr: {href : employer ? '#/reports/work/employer/'+employer.encodedKey : ''}"></a></td>
			<td>
				<p>
					<span data-bind="if: worked === null" class="label label-default"><fmt:message
							key="shared.unknown" /></span> <span data-bind="if: worked === false"
						class="label label-danger"> <span
						class="glyphicon glyphicon-ban-circle"></span> <fmt:message
							key="shared.no" />
					</span> <span data-bind="if: worked === true" class="label label-success">
						<span class="glyphicon glyphicon-ok"></span> <fmt:message
							key="shared.yes" />
					</span>
				</p>
			</td>
			<td><a
				data-bind="attr: { href: '${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '') }">
					<span data-bind="if: verificationStatus === null"
					class="label label-default"><fmt:message
							key="shared.unknown" /></span> <span
					data-bind="if: verificationStatus === 'TEMP_BANNED'"
					class="label label-danger"> <span
						class="glyphicon glyphicon-ban-circle"></span> <fmt:message
							key="shared.tempBanned" />
				</span> <span data-bind="if: verificationStatus === 'WARNING'"
					class="label label-warning"> <span
						class="glyphicon glyphicon-exclamation-sign"></span> <fmt:message
							key="shared.warning" />
				</span> <span data-bind="if: verificationStatus === 'OK'"
					class="label label-success"> <span
						class="glyphicon glyphicon-ok"></span> <fmt:message
							key="shared.ok" />
				</span>
			</a></td>
			<td>
				<div class="btn-toolbar">
                    <div class="btn-group">
                        <button class="btn btn-default dropdown-toggle" 
                        		data-toggle="dropdown"
                        		title="<fmt:message key="management.players.actions"/>">
                        	<span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                            	<a data-bind="if: edist.user.hasManagementAccess,
											  attr: {href: '${baseUrl}/management/playersList/search/' + (stats ? stats.erId : '')  }">
									<span class="glyphicon glyphicon-list"></span> <fmt:message key="header.mod"/>
								</a>
							</li>
                            <li>
                            	<a data-bind="attr: {href: '${baseUrl}/reports/requests/player/' + (stats ? stats.erId : '') }">
									<span class="glyphicon glyphicon-cutlery"></span> <fmt:message key="management.players.template.dist"/>
								</a>
                            </li>
                            <li>
                            	<a data-bind="attr: {href: '${baseUrl}/players/history/player/' + (stats ? stats.erId : '') }">
									<span class="glyphicon glyphicon-calendar"></span> <fmt:message key="players.history"/>
								</a>
                            </li>
                            <li>
                            	 <a data-bind="attr: {href: '${baseUrl}/reports/fights/player/' + (stats ? stats.erId : '')  }">
									<span class="glyphicon glyphicon-screenshot"></span> <fmt:message key="management.players.template.fights"/>
								</a>
                            </li>
                        </ul>
                    </div>
                </div> 
			</td>
		</tr>
	</tbody>
</table>