<table class="table table-striped table-hover table-responsive"
	data-bind="if: !isLoading() && dailies().length > 0">
	<thead>
		<tr>
			<th colspan="6">Distribuições</th>
		</tr>
		<tr>
			<th>Dia</th>
			<th>Jogadores</th>
			<th>Food Fights</th>
			<th>Rockets</th>
			<th>Pedidos</th>
			<th></th>
		</tr>
	</thead>
	<tbody data-bind="foreach: dailies">
		<tr data-bind="attr: {id: encodedKey}">
			<td><a
				data-bind="text: day, attr:{href: '${baseUrl}/reports/requests/day/' + day}"></a>
			</td>
			<td data-bind="text: playersCount"></td>
			<td data-bind="text: ffs"></td>
			<td data-bind="text: $root.sumRockets($data)"></td>
			<td data-bind="text: $root.sumRequests($data)"></td>
			<td><a href="#itemsDetails" data-bind="click: $root.loadDetails">
					<fmt:message key="reports.requests.details.short" /> <span
					class="glyphicon glyphicon-new-window"></span>
			</a></td>
		</tr>
	</tbody>
	<tfoot>
		<tr data-bind="attr: {id: monthly() ? monthly().encodedKey : ''}">
			<td>TOTAL</td>
			<td data-bind="text: monthly() ? monthly().playersCount : ''"></td>
			<td data-bind="text: monthly() ? monthly().ffs : ''"></td>
			<td data-bind="text: monthly() ? sumRockets(monthly()) : ''"></td>
			<td data-bind="text: monthly() ? sumRequests(monthly()) : ''"></td>
			<td data-bind="if: monthly()"><a href="#itemsDetails"
				data-bind="click: $root.loadDetails"> Total de Itens <span
					class="glyphicon glyphicon-new-window"></span>
			</a></td>
		</tr>
	</tfoot>
</table>