<div class="modal fade" id="requestDetails" tabindex="-30" role="dialog"
	aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal"
					aria-hidden="true">×</button>
				<h3>
					<fmt:message key="reports.requests.details" />
				</h3>
			</div>
			<div class="modal-body">
				<table class="table table-striped table-hover table-responsive"
					data-bind="if: requestDetails().length > 0">
					<thead>
						<tr>
							<th><fmt:message key="reports.requests.type" /></th>
							<th><fmt:message key="reports.requests.quality" /></th>
							<th><fmt:message key="reports.requests.quantity" /></th>
							<th><fmt:message key="reports.requests.status" /></th>
						</tr>
					</thead>

					<tbody data-bind="foreach: requestDetails">
						<tr>
							<td><span data-bind="if: type === 'WEAPONS'"
								class="label label-default"><fmt:message
										key="reports.requests.weapons" /></span> <span
								data-bind="if: type === 'FOOD'" class="label label-default"><fmt:message
										key="reports.requests.food" /></span></td>
							<td data-bind="text: quality"></td>
							<td data-bind="text: quantity"></td>
							<td><span data-bind="if: status === 'REQUESTED'"
								class="label label-primary"><fmt:message
										key="reports.requests.requested" /></span> <span
								data-bind="if: status === 'ERROR'" class="label label-danger"><fmt:message
										key="reports.requests.error" /></span> <span
								data-bind="if: status === 'SENT'" class="label label-success"><fmt:message
										key="reports.requests.sent" /></span> <span
								data-bind="if: status === 'SENT_PARTIAL'"
								class="label label-warning"><fmt:message
										key="reports.requests.partial" /></span>
						</tr>
					</tbody>
				</table>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-dismiss="modal">
					<fmt:message key="shared.close" />
				</button>
			</div>
		</div>
	</div>
</div>