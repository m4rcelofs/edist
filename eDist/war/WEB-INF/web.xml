<?xml version="1.0" encoding="utf-8" standalone="no"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.5"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">


	<!-- Entry Points -->


	<!-- admin ep -->
	<servlet>
		<servlet-name>adminEP</servlet-name>
		<jsp-file>/admin/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>adminEP</servlet-name>
		<url-pattern>/admin/*</url-pattern>
	</servlet-mapping>

	<!-- management ep -->
	<servlet>
		<servlet-name>managementEP</servlet-name>
		<jsp-file>/management/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>managementEP</servlet-name>
		<url-pattern>/management/*</url-pattern>
	</servlet-mapping>

	<!-- form ep -->
	<servlet>
		<servlet-name>requestEP</servlet-name>
		<jsp-file>/request/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>requestEP</servlet-name>
		<url-pattern>/request/*</url-pattern>
	</servlet-mapping>

	<!-- reports ep -->
	<servlet>
		<servlet-name>reportsEP</servlet-name>
		<jsp-file>/reports/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>reportsEP</servlet-name>
		<url-pattern>/reports/*</url-pattern>
	</servlet-mapping>

	<!-- player reports ep -->
	<servlet>
		<servlet-name>playersEP</servlet-name>
		<jsp-file>/players/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>playersEP</servlet-name>
		<url-pattern>/players/*</url-pattern>
	</servlet-mapping>

	<!-- Public DWR (requests) -->
	<servlet>
		<display-name>DWR Servlet</display-name>
		<servlet-name>dwr-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.dwr.RequestService,
				
				com.erep.dist.data.enums.RequestType,
				com.erep.dist.data.enums.PlayerStatus,
				com.erep.dist.data.enums.RocketQuality,
				com.erep.dist.data.enums.ResourceQuality,
				com.erep.dist.data.enums.PlayerDistStatus,
				
				com.erep.dist.data.Player,
				com.erep.dist.data.PlayerGroup,
				
				com.erep.dist.dwr.dto.RequestAttempt				
			</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-invoker</servlet-name>
		<url-pattern>/request/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- Private DWR (management) -->
	<servlet>
		<display-name>DWR Management Servlet</display-name>
		<servlet-name>dwr-management-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.data.DistConfig,
				com.erep.dist.data.FightVerification,
				com.erep.dist.data.WorkVerification,
				com.erep.dist.data.Distributor,
				com.erep.dist.data.Player,
				com.erep.dist.data.PlayerGroup,
				com.erep.dist.data.Request,
				com.erep.dist.data.ResourceDist,
				
				com.erep.dist.dwr.ManagementService,
				
				com.erep.dist.dwr.dto.PlayerQuery,
				com.erep.dist.dwr.dto.PlayerGroupQuery,

				com.erep.dist.data.enums.ConfigGranularity,
				com.erep.dist.data.enums.RequestType,
				com.erep.dist.data.enums.PlayerStatus,
				com.erep.dist.data.enums.PlayerDistStatus,
				com.erep.dist.data.enums.RequestStatus,
				com.erep.dist.data.enums.ResourceDistStatus,
				com.erep.dist.data.enums.ResourceType,
				com.erep.dist.data.enums.ResourceQuality,
				com.erep.dist.data.enums.RocketQuality,
				com.erep.dist.data.enums.VerificationAction
    		</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-management-invoker</servlet-name>
		<url-pattern>/management/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- Private DWR (admin) -->
	<servlet>
		<display-name>DWR Admin Servlet</display-name>
		<servlet-name>dwr-admin-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.data.Distributor,
				com.erep.dist.data.Employer,
				com.erep.dist.data.ServerConfig,
				com.erep.dist.data.DistConfig,
				com.erep.dist.data.FightVerification,
				com.erep.dist.data.WorkVerification,
				com.erep.dist.data.RegisteredUser,
				
				com.erep.dist.dwr.dto.RegisteredUserQuery,
				
				com.erep.dist.data.enums.ReportsAccessLevel,
				com.erep.dist.data.enums.RequestType,
				com.erep.dist.data.enums.ResourceQuality,
				com.erep.dist.data.enums.RegisteredUserRole,
				com.erep.dist.data.enums.ConfigGranularity,
				com.erep.dist.data.enums.VerificationAction,
				
				com.erep.dist.dwr.AdminService
    		</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-admin-invoker</servlet-name>
		<url-pattern>/admin/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- Filtered DWR (reports) -->
	<servlet>
		<display-name>DWR Reports Servlet</display-name>
		<servlet-name>dwr-reports-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.data.DailyFights,
				com.erep.dist.data.DailyWork,
				com.erep.dist.data.DailyStats,
				com.erep.dist.data.Distributor,
				com.erep.dist.data.Employer,
				com.erep.dist.data.Player,
				com.erep.dist.data.PlayerGroup,
				com.erep.dist.data.Request,
				com.erep.dist.data.ResourceDist,
				com.erep.dist.data.RequestStatsMonthly,
				com.erep.dist.data.RequestStatsDaily,
				
				com.erep.dist.dwr.ReportService,
				
				com.erep.dist.dwr.dto.RequestQuery,
				com.erep.dist.dwr.dto.WorkQuery,
				com.erep.dist.dwr.dto.WorkWeek,
				com.erep.dist.dwr.dto.WorkWeekQuery,
				com.erep.dist.dwr.dto.FightsQuery,
				com.erep.dist.dwr.dto.FiltersInitialInfo,

				com.erep.dist.data.enums.RequestType,
				com.erep.dist.data.enums.PlayerStatus,
				com.erep.dist.data.enums.PlayerDistStatus,
				com.erep.dist.data.enums.RequestStatus,
				com.erep.dist.data.enums.ResourceDistStatus,
				com.erep.dist.data.enums.ResourceType,
				com.erep.dist.data.enums.ResourceQuality,
				com.erep.dist.data.enums.RocketQuality
    		</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-reports-invoker</servlet-name>
		<url-pattern>/reports/dwr/*</url-pattern>
	</servlet-mapping>


	<!-- Filtered DWR (player reports) -->
	<servlet>
		<display-name>DWR Reports Servlet</display-name>
		<servlet-name>dwr-players-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.dwr.dto.StatsQuery,
				com.erep.dist.dwr.dto.FiltersInitialInfo,
				
				com.erep.dist.dwr.PlayerReportService,
								
				com.erep.dist.data.DailyStats,
				com.erep.dist.data.PlayerGroup,
				com.erep.dist.data.PlayerStatsMonthly,
				com.erep.dist.data.PlayerStatsDaily,
				
				com.erep.dist.data.enums.CountryCode,
				com.erep.dist.data.enums.Division
			</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-players-invoker</servlet-name>
		<url-pattern>/players/dwr/*</url-pattern>
	</servlet-mapping>




	<!-- Cron jobs -->
	<servlet>
		<servlet-name>autoDistJob</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.AutoDistJob</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>autoDistJob</servlet-name>
		<url-pattern>/admin/cron/autoDist</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>licensingJob</servlet-name>
		<servlet-class>com.erep.dist.instances.backend.LicensingJob</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>licensingJob</servlet-name>
		<url-pattern>/admin/cron/licence</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>playerStatsStarterJob</servlet-name>
		<servlet-class>com.erep.dist.instances.backend.PlayerStatsStarterJob</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>playerStatsStarterJob</servlet-name>
		<url-pattern>/admin/cron/playerStatsStarter</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>statisticsStarterJob</servlet-name>
		<servlet-class>com.erep.dist.instances.backend.StatisticsStarterJob</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>statisticsStarterJob</servlet-name>
		<url-pattern>/admin/cron/statistics</url-pattern>
	</servlet-mapping>

	<!-- Install -->
	<servlet>
		<servlet-name>installServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.install.InstallServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>installServlet</servlet-name>
		<url-pattern>/admin/install</url-pattern>
	</servlet-mapping>

	<!-- Player migration -->
	<servlet>
		<servlet-name>dataMigrationServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.install.DataMigrationServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>dataMigrationServlet</servlet-name>
		<url-pattern>/admin/install/migrate</url-pattern>
	</servlet-mapping>

	<!-- Dynamic javascript generation -->
	<servlet>
		<servlet-name>dynamicJavascript</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.JavascriptGenerationServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>dynamicJavascript</servlet-name>
		<url-pattern>/js/dynamic/*</url-pattern>
	</servlet-mapping>

	<!-- Façade to receive work info from employers -->
	<servlet>
		<servlet-name>employersFacadeServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.EmployerFacadeServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>employersFacadeServlet</servlet-name>
		<url-pattern>/employer</url-pattern>
	</servlet-mapping>

	<!-- CSP violation reporting -->
	<servlet>
		<servlet-name>cspReportServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.CSPReportServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>cspReportServlet</servlet-name>
		<url-pattern>/csp</url-pattern>
	</servlet-mapping>

	<!-- Avatar upload callback -->
	<servlet>
		<servlet-name>avatarCallback</servlet-name>
		<servlet-class>com.erep.dist.instances.backend.tasks.AvatarUploadCallbackServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>avatarCallback</servlet-name>
		<url-pattern>/admin/avatarUploadCallback</url-pattern>
	</servlet-mapping>

	<!-- login/logout -->
	<servlet>
		<servlet-name>loginServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.LoginServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>loginServlet</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>
	
	<servlet>
		<servlet-name>logoutServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.frontend.LogoutServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>logoutServlet</servlet-name>
		<url-pattern>/logout</url-pattern>
	</servlet-mapping>

	<!-- default url mapper -->
	<servlet>
		<servlet-name>defaultEP</servlet-name>
		<jsp-file>/index.jsp</jsp-file>
	</servlet>

	<servlet-mapping>
		<servlet-name>defaultEP</servlet-name>
		<url-pattern>/*</url-pattern>
	</servlet-mapping>


	<!-- Security -->

	<!-- Admin only (including app tasks) -->
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Admin</web-resource-name>
			<url-pattern>/admin/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>admin</role-name>
		</auth-constraint>
		<user-data-constraint>
			<transport-guarantee>CONFIDENTIAL</transport-guarantee>
		</user-data-constraint>
	</security-constraint>

	<!-- Management only -->
	<!-- throwing weird 100 URL limit on deploy -->
	<!-- security-constraint>
		<web-resource-collection>
			<web-resource-name>Manager</web-resource-name>
			<url-pattern>/management/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>*</role-name>
		</auth-constraint>
		<user-data-constraint>
			<transport-guarantee>CONFIDENTIAL</transport-guarantee>
		</user-data-constraint>
	</security-constraint-->

	<!-- Filters -->
	<filter>
		<filter-name>languageFilter</filter-name>
		<filter-class>com.erep.dist.i18n.LanguageFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>languageFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>moderatorsFilter</filter-name>
		<filter-class>com.erep.dist.auth.ModeratorsFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>moderatorsFilter</filter-name>
		<url-pattern>/management/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>reportsFilter</filter-name>
		<filter-class>com.erep.dist.auth.ReportsFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>reportsFilter</filter-name>
		<url-pattern>/reports/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>playerReportsFilter</filter-name>
		<filter-class>com.erep.dist.auth.PlayerReportsFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>playerReportsFilter</filter-name>
		<url-pattern>/players/*</url-pattern>
	</filter-mapping>

	<!-- Default File -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>


	<!-- Empty backend starter to avoid 404 error -->
	<servlet>
		<servlet-name>emptyServlet</servlet-name>
		<servlet-class>com.erep.dist.instances.backend.EmptyServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>emptyServlet</servlet-name>
		<url-pattern>/_ah/start</url-pattern>
	</servlet-mapping>

	<!-- Google Stuff -->
	<servlet>
		<servlet-name>SystemServiceServlet</servlet-name>
		<servlet-class>com.google.api.server.spi.SystemServiceServlet</servlet-class>
		<init-param>
			<param-name>services</param-name>
			<param-value />
		</init-param>
	</servlet>
	<servlet-mapping>
		<servlet-name>SystemServiceServlet</servlet-name>
		<url-pattern>/_ah/spi/*</url-pattern>
	</servlet-mapping>


</web-app>