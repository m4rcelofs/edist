<?xml version="1.0" encoding="utf-8" standalone="no"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.5"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd">

	<!-- Public DWR -->
	<servlet>
		<display-name>DWR Servlet</display-name>
		<servlet-name>dwr-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>true</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.dwr.RequestService,
				
				com.erep.dist.data.enums.DistType,
				com.erep.dist.data.enums.PlayerStatus,
				com.erep.dist.data.enums.RocketQuality,
				
				com.erep.dist.data.Player,
				com.erep.dist.data.PlayerGroup,
				
				com.erep.dist.dwr.dto.RequestAttempt
				
			</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-invoker</servlet-name>
		<url-pattern>/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- Private DWR -->
	<servlet>
		<display-name>DWR Admin Servlet</display-name>
		<servlet-name>dwr-admin-invoker</servlet-name>
		<servlet-class>org.directwebremoting.servlet.DwrServlet</servlet-class>
		<init-param>
			<param-name>debug</param-name>
			<param-value>true</param-value>
		</init-param>
		<init-param>
			<param-name>classes</param-name>
			<param-value>
				com.erep.dist.data.DistConfig,
				com.erep.dist.data.Distributor,
				com.erep.dist.data.Player,
				com.erep.dist.data.PlayerGroup,
				com.erep.dist.data.Request,
				com.erep.dist.data.ServerConfig,
				
				com.erep.dist.dwr.AdminService,
				com.erep.dist.dwr.ReportService,
				
				com.erep.dist.dwr.dto.PlayerQuery,
				com.erep.dist.dwr.dto.ReportQuery,

				com.erep.dist.data.enums.ConfigGranularity,
				com.erep.dist.data.enums.DistType,
				com.erep.dist.data.enums.PlayerStatus,
				com.erep.dist.data.enums.RequestStatus,
				com.erep.dist.data.enums.RocketQuality
    		</param-value>
		</init-param>
	</servlet>

	<servlet-mapping>
		<servlet-name>dwr-admin-invoker</servlet-name>
		<url-pattern>/admin/dwr/*</url-pattern>
	</servlet-mapping>

	<!-- Tasks -->
	<servlet>
		<servlet-name>getUserInfoTask</servlet-name>
		<servlet-class>com.erep.dist.servlets.GetUserInfoTask</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>getUserInfoTask</servlet-name>
		<url-pattern>/admin/tasks/getUserInfo</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>processRequestTask</servlet-name>
		<servlet-class>com.erep.dist.servlets.ProcessRequestTask</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>processRequestTask</servlet-name>
		<url-pattern>/admin/tasks/processRequest</url-pattern>
	</servlet-mapping>

	<!-- Install -->
	<servlet>
		<servlet-name>installServlet</servlet-name>
		<servlet-class>com.erep.dist.servlets.install.InstallServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>installServlet</servlet-name>
		<url-pattern>/admin/install</url-pattern>
	</servlet-mapping>

	<!-- Security -->
	<security-constraint>
		<web-resource-collection>
			<url-pattern>/admin/*</url-pattern>
		</web-resource-collection>
		<user-data-constraint>
			<transport-guarantee>CONFIDENTIAL</transport-guarantee>
		</user-data-constraint>
	</security-constraint>

	<!-- Default File -->
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>


	<!-- Google Stuff -->
	<servlet>
		<servlet-name>SystemServiceServlet</servlet-name>
		<servlet-class>com.google.api.server.spi.SystemServiceServlet</servlet-class>
		<init-param>
			<param-name>services</param-name>
			<param-value />
		</init-param>
	</servlet>
	<servlet-mapping>
		<servlet-name>SystemServiceServlet</servlet-name>
		<url-pattern>/_ah/spi/*</url-pattern>
	</servlet-mapping>


</web-app>