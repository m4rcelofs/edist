<queue-entries>
	<queue>
		<name>default</name>
		<rate>5/s</rate>
		<retry-parameters>
			<min-backoff-seconds>60</min-backoff-seconds>
		</retry-parameters>
	</queue>
	<queue>
		<name>erepublik-not-logged-in</name>
		<rate>2/s</rate>
		<max-concurrent-requests>2</max-concurrent-requests>
		<bucket-size>2</bucket-size>
		<retry-parameters>
			<min-backoff-seconds>5</min-backoff-seconds>
		</retry-parameters>
	</queue>
	<queue>
		<name>erepublik-logged-in</name>
		<rate>6/m</rate>
		<max-concurrent-requests>1</max-concurrent-requests>
		<bucket-size>1</bucket-size>
		<retry-parameters>
			<min-backoff-seconds>10</min-backoff-seconds>
		</retry-parameters>
	</queue>
</queue-entries>