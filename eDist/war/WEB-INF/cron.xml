<?xml version="1.0" encoding="UTF-8"?>
<cronentries>

	<cron>
		<url>/admin/cron/autoDist</url>
		<description>Starts auto dist tasks every day</description>
		<schedule>every day 00:02</schedule>
		<timezone>America/Los_Angeles</timezone>
	</cron>
	
	<cron>
		<url>/admin/cron/licence</url>
		<description>Checks if this application is properly licensed</description>
		<schedule>every 12 hours</schedule>
		<timezone>America/Los_Angeles</timezone>
	</cron>
	
</cronentries>