<div data-bind="if: $root.category() &&  $root.category() !== 'all'">
	<nav class="navbar navbar-default" role="navigation">
		<div class="navbar-header">
			<button type="button" class="navbar-toggle" data-toggle="collapse"
				data-target="#requests-filter-collapse">
				<span class="sr-only"><fmt:message key="filters.openClose"/></span> <span
					class="icon-bar"></span> <span class="icon-bar"></span> <span
					class="icon-bar"></span>
			</button>
			<p class="navbar-text"><fmt:message key="filters.title"/></p>
		</div>
		<div class="collapse navbar-collapse" id="requests-filter-collapse">
			<form class="navbar-form navbar-right" role="search"
				data-bind="submit: doSearch">
				<div class="form-group" data-bind="if: $root.category() === 'group'">
					<select class="selectpicker show-menu-arrow navbar-btn show-tick"
						data-bind=" options: groups, 
									optionsText: function(item){ return item ? item.groupName : '' },
									optionsValue: function(item) { return item ? item.encodedKey : '' }, 
									value: filters.searchText, 
									enable: $root.groups().length > 0,
									updateSelectPicker: groups">
					</select>
				</div>
				<div class="form-group"
					data-bind="if: $root.category() === 'search'">
					<input type="text" class="form-control"
						placeholder="<fmt:message key="filters.idNickOrLink"/>"
						data-bind="value: filters.searchText">
				</div>
				<div class="form-group" data-bind="if: $root.category() === 'fight'">
					<select class="selectpicker show-menu-arrow navbar-btn show-tick"
						data-bind="value: filters.searchText, updateSelectPicker:{}">
						<option value="TEMP_BANNED"><fmt:message key="shared.tempBanned"/></option>
						<option value="WARNING"><fmt:message key="shared.warning"/></option>
						<option value="OK"><fmt:message key="shared.ok"/></option>
						<option value="UNKNOWN"><fmt:message key="shared.unverified"/></option>
					</select>
				</div>
				<div class="form-group"
					data-bind="if: $root.category() === 'status'">
					<select class="selectpicker show-menu-arrow navbar-btn show-tick"
						data-bind="value: filters.searchText, updateSelectPicker:{}">
						<option value="NEW"><fmt:message key="shared.new"/></option>
						<option value="ERROR"><fmt:message key="shared.hasError"/></option>
						<option value="ENABLED"><fmt:message key="shared.enabled"/></option>
						<option value="DISABLED"><fmt:message key="shared.disabled"/></option>
					</select>
				</div>
				<div class="form-group" data-bind="if: $root.category() === 'work'">
					<select class="selectpicker show-menu-arrow navbar-btn show-tick"
						data-bind="value: filters.searchText, updateSelectPicker:{}">
						<option value="TEMP_BANNED"><fmt:message key="shared.tempBanned"/></option>
						<option value="WARNING"><fmt:message key="shared.warning"/></option>
						<option value="OK"><fmt:message key="shared.ok"/></option>
						<option value="UNKNOWN"><fmt:message key="shared.unverified"/></option>
					</select>
				</div>
				<button type="submit" class="btn btn-default">
					<span class="glyphicon glyphicon-search"></span> <span
						class="sr-only"><fmt:message key="filters.filter"/></span>
				</button>
			</form>
		</div>
	</nav>
</div>