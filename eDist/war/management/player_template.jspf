<div class="row">
	<div class="col-md-10 col-md-offset-1">
		<div class="panel panel-default"
			data-bind="css: { 'panel-danger': dbStatus() === 'ERROR' }, attr: { id: encodedKey()}">
			<div class="panel-body">
				<div class="row">
					<div class="col-md-3">
						<img class="img-thumbnail img-responsive"
							src="${baseUrl}/img/profile_avatar.cache.png"
							data-bind="style: { background : avatar() === null ? 'url(${baseUrl}/img/default_male.cache.gif) no-repeat center' : 'url(' + avatar() + ') no-repeat center'}">
						<div class="form-group"></div>
						<div class="row">
							<div class="col-md-12">
								<p>
									<a data-toggle="popover"
										data-content="<fmt:message key="management.players.template.dist"/>"
										data-bind="if: dbStatus() === 'ENABLED', 
													attr: {href: '${baseUrl}/reports/requests/player/' + erId() }, updatePopup:{}"><span
										class="glyphicon glyphicon-list"></span></a> <a
										data-toggle="popover"
										data-content="<fmt:message key="management.players.template.work"/>"
										data-bind="if: dbStatus() === 'ENABLED', 
													attr: {href: '${baseUrl}/reports/work/player/' + erId() }, updatePopup:{}"><span
										class="glyphicon glyphicon-wrench"></span></a> <a
										data-toggle="popover"
										data-content="<fmt:message key="management.players.template.stats"/>"
										data-bind="if: dbStatus() === 'ENABLED', 
													attr: {href: '${baseUrl}/players/history/player/' + erId() }, updatePopup:{}"><span
										class="glyphicon glyphicon-stats"></span></a> <a
										data-toggle="popover"
										data-content="<fmt:message key="management.players.template.fights"/>"
										data-bind="if: dbStatus() === 'ENABLED', 
													attr: {href: '${baseUrl}/players/fights/player/' + erId() }, updatePopup:{}"><span
										class="glyphicon glyphicon-screenshot"></span></a>
								</p>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">
								<p>
									<span data-bind="if: dbStatus() === 'NEW'"
										class="label label-info"><fmt:message key="shared.new" /></span>
									<span data-bind="if: dbStatus() === 'ERROR'"
										class="label label-danger"><fmt:message
											key="shared.error" /></span> <span
										data-bind="if: dbStatus() === 'ENABLED'"
										class="label label-success"><fmt:message
											key="shared.enabled" /></span> <span
										data-bind="if: dbStatus() === 'DISABLED'"
										class="label label-default"><fmt:message
											key="shared.disabled" /></span>
								</p>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">
								<p>
									<span data-bind="if: fightStatus() === null"
										class="label label-default"><fmt:message
											key="shared.fights" />: <fmt:message key="shared.unverified" /></span>
									<span data-bind="if: fightStatus() === 'OK'"
										class="label label-success"><fmt:message
											key="shared.fights" />: <fmt:message key="shared.ok" /></span> <span
										data-bind="if: fightStatus() === 'WARNING'"
										class="label label-warning"><fmt:message
											key="shared.fights" />: <fmt:message key="shared.warning" /></span>
									<span data-bind="if: fightStatus() === 'TEMP_BANNED'"
										class="label label-danger"><fmt:message
											key="shared.fights" />: <fmt:message key="shared.tempBanned" /></span>
								</p>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12">
								<p>
									<span data-bind="if: workStatus() === null"
										class="label label-default"><fmt:message
											key="shared.work" />: <fmt:message key="shared.unverified" /></span>
									<span data-bind="if: workStatus() === 'OK'"
										class="label label-success"><fmt:message
											key="shared.work" />: <fmt:message key="shared.ok" /></span> <span
										data-bind="if: workStatus() === 'WARNING'"
										class="label label-warning"><fmt:message
											key="shared.work" />: <fmt:message key="shared.warning" /></span>
									<span data-bind="if: workStatus() === 'TEMP_BANNED'"
										class="label label-danger"><fmt:message
											key="shared.work" />: <fmt:message key="shared.tempBanned" /></span>
								</p>
							</div>
						</div>

					</div>
					<div class="col-md-9 table-responsive">
						<div class="row">
							<div class="col-md-9">
								<strong> <a
									data-bind="attr : { href: 'http://www.erepublik.com/en/citizen/profile/' + erId() }"><span
										data-bind="text: dbStatus() === 'ERROR' ? '<fmt:message key="management.players.doesNotExist"/>' : 
															name() ? name() : '<fmt:message key="management.players.searching"/>'"></span></a>
								</strong>
							</div>
							<div class="col-md-2" data-bind="if: dbStatus() !== 'ERROR'">
								<a data-toggle="popover"
									data-content="<fmt:message key="player.sendMessage"/>"
									data-bind="attr : { href: 'http://www.erepublik.com/en/main/messages-compose/' + erId() }, updatePopup:{}">
									<span class="glyphicon glyphicon-comment"></span>
								</a> <a data-toggle="popover"
									data-content="<fmt:message key="player.donate.items"/>"
									data-bind="attr : { href: 'http://www.erepublik.com/en/economy/donate-items/' + erId() }, updatePopup:{}">
									<span class="glyphicon glyphicon-gift"></span>
								</a> <a data-toggle="popover"
									data-content="<fmt:message key="player.donate.cc"/>"
									data-bind="attr : { href: 'http://www.erepublik.com/en/economy/donate-money/' + erId() }, updatePopup:{}">
									<span class="glyphicon glyphicon-usd"></span>
								</a>
							</div>
							<div class="col-md-1">
								<div class="dropdown pull-right">
									<button class="btn btn-default" data-toggle="dropdown"
										id="actionsDropdown"
										title="<fmt:message key="management.players.actions"/>">
										<span class="caret"></span>
									</button>
									<ul class="dropdown-menu" role="menu"
										aria-labelledby="actionsDropdown">
										<li role="presentation"
											data-bind="if: fightStatus() !== null && fightStatus() !== 'OK'"><a
											data-bind="click: $root.clearFightStatus" role="menuitem"
											tabindex="-1"><span class="glyphicon glyphicon-transfer"></span>
												<fmt:message key="management.players.clear.fights" /></a></li>
										<li role="presentation"
											data-bind="if: workStatus() !== null && workStatus() !== 'OK'"><a
											data-bind="click: $root.clearWorkStatus" role="menuitem"
											tabindex="-1"><span class="glyphicon glyphicon-transfer"></span>
												<fmt:message key="management.players.clear.work" /></a></li>
										<li role="presentation"
											data-bind="if: dbStatus() == 'DISABLED'"><a
											data-bind="click: $root.enable" role="menuitem" tabindex="-1"><span
												class="glyphicon glyphicon-asterisk"></span> <fmt:message
													key="shared.enable" /></a></li>
										<li role="presentation"
											data-bind="if: dbStatus() == 'ENABLED'"><a
											data-bind="click: $root.disable" role="menuitem"
											tabindex="-1"><span
												class="glyphicon glyphicon-ban-circle"></span> <fmt:message
													key="shared.disable" /> </a></li>
										<li role="presentation" data-bind="if: dbStatus() == 'ERROR'"><a
											data-bind="click: $root.remove" role="menuitem" tabindex="-1"><span
												class="glyphicon glyphicon-remove"></span> <fmt:message
													key="management.players.remove" /></a></li>
									</ul>
								</div>
							</div>
						</div>
						<table class="table table-condensed">
							<tbody>
								<tr>
									<td><span class="glyphicon glyphicon-tags"></span> <fmt:message
											key="management.players.groups" />:</td>
									<td><select class="selectpicker show-menu-arrow"
										title="<fmt:message key="management.players.groupSelect"/>"
										multiple data-selected-text-format="count>3"
										data-count-selected-text="<fmt:message key="management.players.selectedText"/>"
										data-bind="options: $root.groups, 
															optionsText: 'groupName',
															optionsValue: 'encodedKey', 
															selectedOptions: groupIds,
															enable: dbStatus() === 'ENABLED',
												 	 		updateSelectPicker: dbStatus">
									</select></td>
								</tr>
								<tr>
									<td><span class="glyphicon glyphicon-fire"></span> <fmt:message
											key="management.players.rocketFactory" />:</td>
									<td><select class="selectpicker show-menu-arrow show-tick"
										data-bind="value: rocketEnabled(),
														   enable: dbStatus() === 'ENABLED',
														   updateSelectPicker: dbStatus">
											<option value="NONE" data-subtext="):">
												<fmt:message key="management.players.noRocket" />
											</option>
											<option value="Q1">
												<fmt:message key="management.players.fQ1" />
											</option>
											<option value="Q2">
												<fmt:message key="management.players.fQ2" />
											</option>
											<option value="Q3">
												<fmt:message key="management.players.fQ3" />
											</option>
											<option value="Q4">
												<fmt:message key="management.players.fQ4" />
											</option>
											<option value="Q5">
												<fmt:message key="management.players.fQ5" />
											</option>
									</select> <span class="pull-right"><a href="#" class="help"
											data-toggle="popover" title=""
											data-content="<fmt:message key="management.players.rockets.help"/>"
											data-bind="updatePopup:{}"> <span
												class="glyphicon glyphicon-question-sign"></span>
										</a></span></td>
								</tr>
								<tr
									data-bind="if: $root.playerConfigEnabled() === true 
													   && dbStatus() === 'ENABLED'">
									<td><span class="glyphicon glyphicon-cog"></span> <fmt:message
											key="management.groups.dist" />:</td>
									<td><a class="btn btn-default"
										data-bind="click: $root.addConfig, visible: config() === null"
										title="<fmt:message key="management.groups.addConfig"/>">
											<span class="glyphicon glyphicon-new-window"></span> <fmt:message
												key="management.groups.add" />
									</a> <a class="btn btn-default"
										data-bind="click: $root.editConfig, visible: config() !== null"
										title="<fmt:message key="management.groups.editConfig"/>">
											<span class="glyphicon glyphicon-pencil"></span> <fmt:message
												key="management.groups.edit" />
									</a> <a class="btn btn-sm btn-default"
										data-bind="click: $root.removeConfig, visible: config() !== null"
										title="<fmt:message key="management.groups.removeConfig"/>">
											<span class="glyphicon glyphicon-remove"></span> <fmt:message
												key="management.groups.remove" />
									</a> <span class="pull-right" data-bind="if: config() === null"><a
											class="help" data-toggle="popover" title=""
											data-content="<fmt:message key="management.players.config.help"/>"
											data-bind="updatePopup:{}"> <span
												class="glyphicon glyphicon-question-sign"></span>
										</a></span></td>
								</tr>
								<tr
									data-bind="if: $root.playerConfigEnabled() === true
													   && dbStatus() === 'ENABLED'">
									<td><span class="glyphicon glyphicon-screenshot"></span> <fmt:message
											key="management.groups.fightVerif" />:</td>
									<td><a class="btn btn-default"
										data-bind="click: $root.addFightVerif, visible: fightVerif() === null"
										title="<fmt:message key="management.groups.add"/> <fmt:message key="management.groups.fightVerif"/>">
											<span class="glyphicon glyphicon-new-window"></span> <fmt:message
												key="management.groups.add" />
									</a> <a class="btn btn-default"
										data-bind="click: $root.editFightVerif, visible: fightVerif() !== null"
										title="<fmt:message key="management.groups.edit"/> <fmt:message key="management.groups.fightVerif"/>">
											<span class="glyphicon glyphicon-pencil"></span> <fmt:message
												key="management.groups.edit" />
									</a> <a class="btn btn-sm btn-default"
										data-bind="click: $root.removeFightVerif, visible: fightVerif() !== null"
										title="<fmt:message key="management.groups.remove"/> <fmt:message key="management.groups.fightVerif"/>">
											<span class="glyphicon glyphicon-remove"></span> <fmt:message
												key="management.groups.remove" />
									</a> <span class="pull-right" data-bind="if: fightVerif() === null"><a
											class="help" data-toggle="popover"
											data-content="<fmt:message key="management.players.fightVerif.help"/>"
											data-bind="updatePopup:{}"> <span
												class="glyphicon glyphicon-question-sign"></span>
										</a></span></td>
								</tr>
								<tr
									data-bind="if: $root.playerConfigEnabled() === true
													   && dbStatus() === 'ENABLED'">
									<td><span class="glyphicon glyphicon-wrench"></span> <fmt:message
											key="management.groups.workVerif" />:</td>
									<td><a class="btn btn-default"
										data-bind="click: $root.addWorkVerif, visible:
													workVerif() === null"
										title="<fmt:message key="management.groups.add"/> <fmt:message key="management.groups.workVerif"/>">
											<span class="glyphicon glyphicon-new-window"></span> <fmt:message
												key="management.groups.add" />
									</a> <a class="btn btn-default"
										data-bind="click: $root.editWorkVerif, visible: workVerif() !== null"
										title="<fmt:message key="management.groups.edit"/> <fmt:message key="management.groups.workVerif"/>">
											<span class="glyphicon glyphicon-pencil"></span> <fmt:message
												key="management.groups.edit" />
									</a> <a class="btn btn-sm btn-default"
										data-bind="click: $root.removeWorkVerif, visible: workVerif() !== null"
										title="<fmt:message key="management.groups.remove"/> <fmt:message key="management.groups.workVerif"/>">
											<span class="glyphicon glyphicon-remove"></span> <fmt:message
												key="management.groups.remove" />
									</a> <span class="pull-right" data-bind="if: workVerif() === null"><a
											class="help" data-toggle="popover"
											data-content="<fmt:message key="management.players.workVerif.help"/>"
											data-bind="updatePopup:{}"> <span
												class="glyphicon glyphicon-question-sign"></span>
										</a></span></td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
				<button class="btn btn-primary pull-right"
					data-bind="click: $root.savePlayer, enable: dbStatus() !== 'NEW' && dbStatus() !== 'ERROR'"
					title="Salvar">
					<span class="glyphicon glyphicon-floppy-disk"></span>
					<fmt:message key="shared.save" />
				</button>
			</div>
		</div>
	</div>
</div>