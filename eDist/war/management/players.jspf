<div class="tab-pane" id="playersList">

	<div class="form-group"></div>
	<%@ include file="player_new.jspf"%>
	<div class="form-group"></div>

	<div class="row">
		<div class="col-md-2">
			<ul id="players.horizontal.nav" class="nav nav-pills nav-stacked">
				<li data-bind="css: {active : category() === 'all'}"><a
					href="#/management/playersList/all"><fmt:message
							key="filters.all" /></a></li>
				<li data-bind="css: {active : category() === 'search'}"><a
					href="#/management/playersList/search"><fmt:message
							key="filters.search" /></a></li>
				<li data-bind="css: {active : category() === 'group'}"><a
					href="#/management/playersList/group"><fmt:message
							key="filters.byGroup" /></a></li>
				<li data-bind="css: {active : category() === 'fight'}"><a
					href="#/management/playersList/fight"><fmt:message
							key="filters.byFight" /></a></li>
				<li data-bind="css: {active : category() === 'status'}"><a
					href="#/management/playersList/status"><fmt:message
							key="filters.byStatus" /></a></li>
				<li data-bind="css: {active : category() === 'work'}"><a
					href="#/management/playersList/work"><fmt:message
							key="filters.byWork" /></a></li>
			</ul>
		</div>
		<div class="col-md-10">

			<%@ include file="player_filters.jspf"%>

			<!-- 			<div class="text-center" data-bind="if: players().length == 0"> -->
			<%-- 				<img id="players-loader" src="${baseUrl}/img/loader.cache.gif" /> --%>
			<!-- 			</div> -->

			<div data-bind="foreach: players">
				<%@ include file="player_template.jspf"%>
			</div>

			<ul class="pager">
				<li class="next"
					data-bind="css: {disabled: playersCursor() === null || playersCursor() === ''},
						click: loadNextPage"><a
					href="#"><fmt:message key="shared.showNext" /></a></li>
			</ul>
		</div>
	</div>
	<div class="form-group"></div>
</div>