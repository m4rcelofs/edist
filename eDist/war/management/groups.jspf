	<div class="form-group"></div>
	<div class="panel-group" id="add-group-accordion">
		<div class="panel panel-default">
			<div class="panel-heading">
				<a class="accordion-toggle" data-toggle="collapse"
					data-parent="#add-group-accordion" href="#group-collapse-one"><span
					class="glyphicon glyphicon-plus-sign"></span> Adicionar Grupo</a>
			</div>
			<div id="group-collapse-one" class="panel-collapse collapse">
				<div class="panel-body">
					<form id="add-group-form" class="form-inline" role="form"
						onsubmit="return false;">
						<div class="form-group">
							<label class="sr-only" for="new-group-name">Nome</label> <input
								type="text" class="form-control" id="new-group-name"
								placeholder="Nome">
						</div>
						<button id="save-new-group" class="btn btn-primary"
							onclick="GroupsViewModel.addGroup();">
							<span class="glyphicon glyphicon-floppy-disk"></span> Salvar
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<div class="form-group"></div>
	<div data-bind="foreach: groups">
		<div class="row">
			<div class="col-md-10 col-md-offset-1">
				<div class="panel panel-default"
					data-bind="css: { 'panel-primary': groupName === 'Default' }, attr: { id: encodedKey}">
					<div class="panel-heading">
						<h3 class="panel-title" data-bind="text: groupName"></h3>
					</div>
					<div class="panel-body">
						<div class="row">
							<div class="col-md-12 table-responsive">
								<div
									data-bind="if: $root.groupConfigEnabled() && config === null || fightVerif === null || workVerif === null">
									<div class="alert alert-info">
										<span class="glyphicon glyphicon-question-sign"></span> Caso
										as configurações de distribuição ou verificações não sejam
										definidas, serão utilizadas as padrão da Unidade Militar.
									</div>
								</div>
								<table class="table table-condensed">
									<tbody>
										<tr>
											<td>Nome:</td>
											<td>
												<div data-bind="if: groupName !== 'Default'">
													<input data-bind="value: groupName" />
												</div>
												<div data-bind="if: groupName === 'Default'">
													<span data-bind="text: groupName"></span>
												</div>
											</td>
										</tr>
										<tr data-bind="visible: $root.groupConfigEnabled()">
											<td><span class="glyphicon glyphicon-cog"></span>
												Distribuição:</td>
											<td><a href="javascript:void(0);"
												class="btn btn-default"
												data-bind="click: $root.addConfig, visible: config === null"
												title="Adicionar Configuração"> <span
													class="glyphicon glyphicon-new-window"></span> Adicionar
											</a> <a href="javascript:void(0);" class="btn btn-default"
												data-bind="click: $root.editConfig, visible: config !== null"
												title="Editar Configuração"> <span
													class="glyphicon glyphicon-pencil"></span> Editar
											</a> <a href="javascript:void(0);" class="btn btn-sm btn-default"
												data-bind="click: $root.removeConfig, visible: config !== null"
												title="Remover Configuração"> <span
													class="glyphicon glyphicon-remove"></span> Remover
											</a></td>
										</tr>
										<tr data-bind="visible: $root.groupConfigEnabled() === true">
											<td><span class="glyphicon glyphicon-screenshot"></span>
												Verificação de Lutas:</td>
											<td><a href="javascript:void(0);"
												class="btn btn-default"
												data-bind="click: $root.addFightVerif, visible: fightVerif === null"
												title="Adicionar Verificação de Lutas"> <span
													class="glyphicon glyphicon-new-window"></span> Adicionar
											</a> <a href="javascript:void(0);" class="btn btn-default"
												data-bind="click: $root.editFightVerif, visible:fightVerif !== null"
												title="Editar Verificação de Lutas"> <span
													class="glyphicon glyphicon-pencil"></span> Editar
											</a> <a href="javascript:void(0);" class="btn btn-sm btn-default"
												data-bind="click: $root.removeFightVerif, visible: fightVerif !== null"
												title="Remover Verificação de Lutas"> <span
													class="glyphicon glyphicon-remove"></span> Remover
											</a></td>
										</tr>
										<tr data-bind="visible: $root.groupConfigEnabled() === true">
											<td><span class="glyphicon glyphicon-wrench"></span>
												Verificação de Trabalho:</td>
											<td><a href="javascript:void(0);"
												class="btn btn-default"
												data-bind="click: $root.addWorkVerif, visible: workVerif === null"
												title="Adicionar Verificação de Trabalho"> <span
													class="glyphicon glyphicon-new-window"></span> Adicionar
											</a> <a href="javascript:void(0);" class="btn btn-default"
												data-bind="click: $root.editWorkVerif, visible: workVerif !== null"
												title="Editar Verificação de Trabalho"> <span
													class="glyphicon glyphicon-pencil"></span> Editar
											</a> <a href="javascript:void(0);" class="btn btn-sm btn-default"
												data-bind="click: $root.removeWorkVerif, visible: workVerif !== null"
												title="Remover Verificação de Trabalho"> <span
													class="glyphicon glyphicon-remove"></span> Remover
											</a></td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
						<button class="btn btn-primary pull-right"
							data-bind="click: $root.saveGroup" title="Salvar">
							<span class="glyphicon glyphicon-floppy-disk"></span> Salvar
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>