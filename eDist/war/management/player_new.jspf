<div class="panel-group" id="add-player-accordion">
	<div class="panel panel-default">
		<div class="panel-heading">
			<a class="accordion-toggle" data-toggle="collapse"
				data-parent="#add-player-accordion" href="#player-collapse-one"><span
				class="glyphicon glyphicon-plus-sign"></span> <fmt:message
					key="management.players.add" /></a>
		</div>
		<div id="player-collapse-one" class="panel-collapse collapse">
			<div class="panel-body">
				<form id="add-player-form" class="form-inline" role="form"
					data-bind="submit: addPlayer">
					<div class="form-group">
						<label class="sr-only" for="new-player-id"><fmt:message
								key="management.players.id" /></label> <input type="text"
							class="form-control" id="new-player-id"
							placeholder="<fmt:message key="management.players.id"/>"
							data-bind="value : newPlayer.erId">
					</div>
					<div class="form-group">
						<label class="sr-only" for="new-player-rocket"><fmt:message
								key="management.players.rocketFactory" /></label> <select
							id="new-player-rocket"
							class="selectpicker show-menu-arrow show-tick"
							data-bind="value: newPlayer.rocketEnabled, updateSelectPicker:{}"
							data-container="#playersList">
							<option value="NONE" data-subtext="):"><fmt:message key="management.players.noRocket"/></option>
							<option value="Q1"><fmt:message key="management.players.fQ1"/></option>
							<option value="Q2"><fmt:message key="management.players.fQ2"/></option>
							<option value="Q3"><fmt:message key="management.players.fQ3"/></option>
							<option value="Q4"><fmt:message key="management.players.fQ4"/></option>
							<option value="Q5"><fmt:message key="management.players.fQ5"/></option>
						</select>
					</div>
					<div class="form-group">
						<select class="selectpicker show-menu-arrow" multiple
							title="<fmt:message key="management.players.groupSelect"/>"
							data-selected-text-format="count>3"
							data-count-selected-text="<fmt:message key="management.players.selectedText"/>"
							data-bind="options: $root.groups, 
											optionsText: 'groupName',
											optionsValue: 'encodedKey', 
											selectedOptions: newPlayer.groupIds,
											updateSelectPicker: $root.groups"
							data-container="#playersList">
						</select>
					</div>
					<button id="save-new-player" class="btn btn-primary" type="submit">
						<span class="glyphicon glyphicon-floppy-disk"></span> <fmt:message key="shared.save"/>
					</button>
				</form>
			</div>
		</div>
	</div>
</div>