<div class="modal fade" id="distConfigDialog" tabindex="-10"
	role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3><span class="glyphicon glyphicon-cog"></span> <fmt:message key="distconfig.title"/></h3>
			</div>
			<div class="modal-body">
				<form id="dist-config-form" class="form-horizontal" role="form"
					onsubmit="return false;">
					<%@ include file="dist-config-basic.jspf"%>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-bind="click: updateRoot"><fmt:message key="shared.ok"/></button>
				<button class="btn" data-bind="click: cancel"><fmt:message key="shared.cancel"/></button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="fightVerifDialog" tabindex="-11"
	role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3><span class="glyphicon glyphicon-screenshot"></span> <fmt:message key="distconfig.fightVerif.title"/></h3>
			</div>
			<div class="modal-body">
				<form id="fight-verif-form" class="form-horizontal" role="form"
					onsubmit="return false;">
					<%@ include file="dist-config-fight-verif.jspf"%>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-bind="click: updateRoot"><fmt:message key="shared.ok"/></button>
				<button class="btn" data-bind="click: cancel"><fmt:message key="shared.cancel"/></button>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="workVerifDialog" tabindex="-12"
	role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h3><span class="glyphicon glyphicon-wrench"></span> <fmt:message key="distconfig.workVerif.title"/></h3>
			</div>
			<div class="modal-body">
				<form id="work-verif-form" class="form-horizontal" role="form"
					onsubmit="return false;">
					<%@ include file="dist-config-work-verif.jspf"%>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-primary" data-bind="click: updateRoot"><fmt:message key="shared.ok"/></button>
				<button class="btn" data-bind="click: cancel"><fmt:message key="shared.cancel"/></button>
			</div>
		</div>
	</div>
</div>