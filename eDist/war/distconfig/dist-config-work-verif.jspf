<div class="panel panel-default">
	<div class="panel-heading">
		<h4 class="panel-title">
			<span class="glyphicon glyphicon-wrench"></span> <a
				class="accordion-toggle" data-toggle="collapse"
				data-parent="#verification-accordion"
				href="#work-verification-panel">Verificação de Trabalho</a>
		</h4>
	</div>
	<div id="work-verification-panel" class="panel-collapse collapse">
		<div class="panel-body">
			<div class="form-group">
				<label class="control-label col-md-6 sr-only"
					for="work-verification-action">Ação</label>
				<div class="col-md-5">
					<select class="form-control work-verification-group"
						data-style="btn-inverse" name="work-verification-action"
						id="work-verification-action"
						data-bind="value: currentConfig.workVerifAction">
						<option value="NONE">Não fazer nada...</option>
						<option value="WARN">Avisar...</option>
						<option value="TEMP_BAN">Bloquear distribuição...</option>
					</select>
				</div>
			</div>
			<div class="form-group">
				<label class="control-label col-md-6" for="work-verification-pct">...
					caso o jogador não trabalhe ao menos ...</label>
				<div class="col-md-5">
					<div class="input-group">
						<input type="number" class="form-control work-verification-group"
							id="work-verification-pct" required min="0"
							data-bind="value: currentConfig.minWorkedDaysPct, enable: currentConfig.workVerifAction() != 'NONE'">
						<span class="input-group-addon">%</span>
					</div>
				</div>
			</div>
			<div class="form-group">
				<label class="control-label col-md-6" for="work-verification-days">...
					dos últimos ...</label>
				<div class="col-md-5">
					<div class="input-group">
						<input type="number" class="form-control work-verification-group"
							id="work-verification-days" required
							data-bind="value: currentConfig.workVerifDays, enable: currentConfig.workVerifAction() != 'NONE'"><span
							class="input-group-addon" min="0">dias</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>