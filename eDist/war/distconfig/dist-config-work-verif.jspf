<div class="form-group">
	<label class="control-label col-md-6 sr-only"
		for="work-verification-action"><fmt:message key="distconfig.action"/></label>
	<div class="col-md-5">
		<select
			class="form-control work-verification-group selectpicker show-menu-arrow show-tick"
			name="work-verification-action" id="work-verification-action"
			data-bind="value: currentWorkVerif.workVerifAction, updateSelectPicker: currentWorkVerif.workVerifAction">
			<option value="NONE"><fmt:message key="distconfig.action.none"/></option>
			<option value="WARN"><fmt:message key="distconfig.action.warn"/></option>
			<option value="TEMP_BAN"><fmt:message key="distconfig.action.ban"/></option>
		</select>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="work-verification-pct"><fmt:message key="distconfig.action.work"/></label>
	<div class="col-md-5">
		<div class="input-group">
			<input type="number" class="form-control work-verification-group"
				id="work-verification-pct" required min="0"
				data-bind="value: currentWorkVerif.minWorkedDaysPct, enable: currentWorkVerif.workVerifAction() != 'NONE'">
			<span class="input-group-addon">%</span>
		</div>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="work-verification-days"><fmt:message key="distconfig.action.workDays"/></label>
	<div class="col-md-5">
		<div class="input-group">
			<input type="number" class="form-control work-verification-group"
				id="work-verification-days" required
				data-bind="value: currentWorkVerif.workVerifDays, enable: currentWorkVerif.workVerifAction() != 'NONE'"><span
				class="input-group-addon" min="0"> <fmt:message key="distconfig.action.days"/></span>
		</div>
	</div>
</div>