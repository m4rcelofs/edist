<div class="form-group">
	<label class="control-label col-md-6" for="maxFF">Máximo de FFs</label>
	<div class="col-md-5">
		<input type="number" class="form-control" id="maxFF" placeholder="FF"
			required min="1" data-bind="value: currentConfig.currentMaxDailyFF">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="Uma Food Fight (FF) é igual a 10 de energia"
		data-original-title="Food Fight" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="rocketAllowed">Distribuição
		de foguetes ativada</label>
	<div class="col-md-5">
		<input type="checkbox" class="form-control" id="rocketAllowed"
			data-bind="checked: currentConfig.rocketAllowed">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="Envia armas de todas as qualidades. O nível do foguete é definido no cadastro do jogador."
		data-original-title="Foguetes" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="autoDist">Distribuição
		automática ativada</label>
	<div class="col-md-5">
		<input type="checkbox" class="form-control" id="autoDist"
			data-bind="checked: currentConfig.autoSend">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="Ativa a distribuição automática de FFs na virada do dia (foguetes não são enviados)"
		data-original-title="Distribuição automática" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="distType">Tipo da
		Distribuição</label>
	<div class="col-md-5">
		<select class="form-control" data-style="btn-inverse" name="distType"
			id="distType" data-bind="value: currentConfig.allowedType">
			<option value="WEAPONS_FOOD">Armas + Alimentos</option>
			<option value="WEAPONS">Somente Armas</option>
			<option value="FOOD">Somente Alimentos</option>
		</select>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="distWeaponQuality">Qualidade
		das Armas</label>
	<div class="col-md-5">
		<select class="form-control" data-style="btn-inverse"
			name="distWeaponQuality" id="distWeaponQuality"
			data-bind="value: currentConfig.allowedWeaponQuality">
			<option value="Q7">Q7</option>
			<option value="Q6">Q6</option>
			<option value="Q5">Q5</option>
			<option value="Q4">Q4</option>
			<option value="Q3">Q3</option>
			<option value="Q2">Q2</option>
			<option value="Q1">Q1</option>
		</select>
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="A qualidade dos alimentos é escolhida com base no disponível"
		data-original-title="Qualidade" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="dist-config-distributor">Distribuidor</label>
	<div class="col-md-5">
		<select class="form-control" data-style="btn-inverse"
			name="dist-config-distributor" id="dist-config-distributor"
			data-bind=" options: distributors, 
									optionsText: function(item){ return item.name ? item.name : item.email ? item.email : item.encodedKey;}, 
									value: currentConfig.distributor, 
									enable: distributors() !== null">
		</select>
	</div>
</div>
