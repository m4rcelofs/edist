<div class="form-group">
	<label class="control-label col-md-6" for="maxFF"><fmt:message key="distconfig.maxFF"/></label>
	<div class="col-md-5">
		<input type="number" class="form-control" id="maxFF" placeholder="FF"
			required min="1" data-bind="value: currentConfig.currentMaxDailyFF">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="<fmt:message key="distconfig.ff.help"/>"
		data-original-title="Food Fight" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="autoDist"><fmt:message key="distconfig.autoDist"/></label>
	<div class="col-md-5">
		<input type="checkbox" class="form-control" id="autoDist"
			data-bind="checked: currentConfig.autoSend, enable: currentConfig.currentMaxDailyFF() > 0">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="<fmt:message key="distconfig.autoDist.help"/>"
		data-original-title="<fmt:message key="distconfig.autoDist.title"/>"
		data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="distType"><fmt:message key="distconfig.distType"/></label>
	<div class="col-md-5">
		<select class="form-control selectpicker show-menu-arrow show-tick"
			name="distType" id="distType"
			data-bind="value: currentConfig.allowedType, enable: currentConfig.currentMaxDailyFF() > 0, updateSelectPicker: currentConfig.currentMaxDailyFF">
			<option value="WEAPONS_FOOD"><fmt:message key="distconfig.distType.both"/></option>
			<option value="WEAPONS"><fmt:message key="distconfig.distType.weapons"/></option>
			<option value="FOOD"><fmt:message key="distconfig.distType.food"/></option>
		</select>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="distWeaponQuality"><fmt:message key="distconfig.distQuality"/></label>
	<div class="col-md-5">
		<select class="form-control selectpicker show-menu-arrow show-tick"
			name="distWeaponQuality" id="distWeaponQuality"
			data-bind="value: currentConfig.allowedWeaponQuality, enable: currentConfig.currentMaxDailyFF() > 0, updateSelectPicker: currentConfig.currentMaxDailyFF">
			<option value="Q7">Q7</option>
			<option value="Q6">Q6</option>
			<option value="Q5">Q5</option>
			<option value="Q4">Q4</option>
			<option value="Q3">Q3</option>
			<option value="Q2">Q2</option>
			<option value="Q1">Q1</option>
		</select>
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="<fmt:message key="distconfig.distQuality.help"/>"
		data-original-title="<fmt:message key="distconfig.distQuality.title"/>" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="rocketAllowed"><fmt:message key="distconfig.rocket"/></label>
	<div class="col-md-5">
		<input type="checkbox" class="form-control" id="rocketAllowed"
			data-bind="checked: currentConfig.rocketAllowed">
	</div>
	<a href="#" class="help" data-toggle="popover" title
		data-content="<fmt:message key="distconfig.rocket.help"/>"
		data-original-title="<fmt:message key="distconfig.rocket.title"/>" data-bind="updatePopup:{}"> <span
		class="glyphicon glyphicon-question-sign"></span>
	</a>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="dist-config-distributor"><fmt:message key="distconfig.distributor"/></label>
	<div class="col-md-5">
		<select class="form-control selectpicker show-menu-arrow show-tick"
			name="dist-config-distributor" id="dist-config-distributor"
			data-bind=" options: distributors, 
						optionsText: function(item){ return item.name ? item.name : item.email ? item.email : '<fmt:message key="distconfig.distributor.noName"/>';},
						optionsValue: 'encodedKey', 
						value: currentConfig.distributor, 
						enable: distributors() !== null,
						updateSelectPicker: distributors">
		</select>
	</div>
</div>