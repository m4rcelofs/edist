<div class="form-group">
	<label class="control-label col-md-6 sr-only"
		for="fight-verification-action">Ação</label>
	<div class="col-md-5">
		<select
			class="form-control fight-verification-group selectpicker show-menu-arrow show-tick"
			name="fight-verification-action" id="fight-verification-action"
			data-bind="value: currentFightVerif.fightVerifAction, updateSelectPicker: {}">
			<option value="NONE">Não fazer nada...</option>
			<option value="WARN">Avisar...</option>
			<option value="TEMP_BAN">Bloquear distribuição...</option>
		</select>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="fight-verification-pct">...
		caso o jogador não lute ao menos ...</label>
	<div class="col-md-5">
		<div class="input-group">
			<input type="number" class="form-control fight-verification-group"
				id="fight-verification-pct" required min="0"
				data-bind="value: currentFightVerif.fightVerifPct, enable: currentFightVerif.fightVerifAction() != 'NONE'">
			<span class="input-group-addon"> %</span>
		</div>
	</div>
</div>
<div class="form-group">
	<label class="control-label col-md-6" for="fight-verification-days">...
		das FFs requisitadas nos últimos ...</label>
	<div class="col-md-5">
		<div class="input-group">
			<input type="number" class="form-control fight-verification-group"
				id="fight-verification-days" required
				data-bind="value: currentFightVerif.fightVerifDays, enable: currentFightVerif.fightVerifAction() != 'NONE'"><span
				class="input-group-addon" min="0"> dias</span>
		</div>
	</div>
</div>